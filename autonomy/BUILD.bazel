load(":bazel_tests.bzl", "perception_py_test", "perception_test_name")
load(
    ":source_snapshot_targets.bzl",
    "NATIVE_CACHE_RETENTION_HOST_SOURCES",
    "RESOURCE_SOURCE_LAYER_GLOBS",
    "SUSTAINED_CHECKPOINT_RETENTION_HOST_SOURCES",
    "SUSTAINED_CONTROLLER_HOST_SOURCES",
    "SUSTAINED_PILOT_RETENTION_HOST_SOURCES",
    "SUSTAINED_RUN_SOURCE_GLOBS",
)

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sustained-run-sources",
    srcs = glob(SUSTAINED_RUN_SOURCE_GLOBS, exclude = ["**/__pycache__/**"]) + [
        "//autonomy/camera:all_py",
        "//autonomy/dataset:all_py",
        "//autonomy/detection:all_py",
        "//autonomy/evidence:all_py",
        "//autonomy/geometry:all_py",
        "//autonomy/inspection:all_py",
        "//autonomy/insula:all_py",
        "//autonomy/range_view:all_py",
        "//autonomy/segmentation:all_py",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "resource-source-layer",
    srcs = glob(RESOURCE_SOURCE_LAYER_GLOBS, exclude = ["**/__pycache__/**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sustained-controller-host",
    srcs = SUSTAINED_CONTROLLER_HOST_SOURCES,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sustained-checkpoint-retention-host",
    srcs = SUSTAINED_CHECKPOINT_RETENTION_HOST_SOURCES,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sustained-pilot-retention-host",
    srcs = SUSTAINED_PILOT_RETENTION_HOST_SOURCES,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "native-cache-retention-host",
    srcs = NATIVE_CACHE_RETENTION_HOST_SOURCES,
    visibility = ["//visibility:public"],
)

PERCEPTION_TEST_MODULES = glob(
    [
        "**/test_*.py",
        "**/*_test.py",
    ],
    exclude = [
        "camera/**",
        "dataset/**",
        "detection/**",
        "inspection/**",
        "range_view/**",
        "segmentation/**",
        "research/**",
        "source_snapshot_targets_test.py",
    ],
)

PERCEPTION_RUNFILES = glob(
    ["**"],
    exclude = [
        "camera/**",
        "dataset/**",
        "detection/**",
        "inspection/**",
        "range_view/**",
        "segmentation/**",
        "research/**",
        "**/__pycache__/**",
    ],
) + [
    "//autonomy/camera:runfiles",
    "//autonomy/dataset:runfiles",
    "//autonomy/inspection:runfiles",
    "//autonomy/segmentation:runfiles",
    "research/association41-runtime-admission-20261003a/manifest.json",
]

PERCEPTION_DEPS = [
    "//autonomy/camera:camera",
    "//autonomy/dataset:dataset",
    "//autonomy/detection:detection",
    "//autonomy/evidence:evidence",
    "//autonomy/geometry:geometry",
    "//autonomy/inspection:inspection",
    "//autonomy/insula:insula",
    "//autonomy/range_view:range_view",
    "//autonomy/segmentation:segmentation",
]

PERCEPTION_EXTRA_DATA = {}

ARCHITECTURE_EXPERIMENT_RESEARCH_INPUTS = [
    "research/architecture-all_pillars-cache-verified.json",
    "research/architecture-retain64-cache-verified.json",
    "research/architecture-retention-controls-spec.md",
    "research/architecture-window-control-spec.md",
    "research/normalization-secondary-decoder-spec.md",
    "research/overfit-native-cache-progress.json",
    "research/training-anchor-templates.candidate.json",
]

filegroup(
    name = "architecture_experiment_runner_snapshot",
    srcs = [
        "BUILD.bazel",
        "architecture/experiment_runner.py",
        "architecture/harness/files.json",
        "architecture/registry.json",
        "//autonomy/camera:all_py",
        "//autonomy/dataset:all_py",
        "//autonomy/detection:all_py",
        "//autonomy/evidence:source_snapshot_py",
        "//autonomy/geometry:all_py",
        "//autonomy/inspection:all_py",
        "//autonomy/insula:all_py",
        "//autonomy/range_view:all_py",
        "//autonomy/segmentation:all_py",
    ] + glob([
        "architecture/harness/*.py",
        "gpu/*.py",
        "pipeline/*.py",
    ]) + ARCHITECTURE_EXPERIMENT_RESEARCH_INPUTS,
    visibility = ["//visibility:public"],
)

genquery(
    name = "sustained_run_sources_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:sustained-run-sources)) union labels("data", deps(//autonomy:sustained-run-sources))))',
    scope = [":sustained-run-sources"],
)

genquery(
    name = "resource_source_layer_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:resource-source-layer)) union labels("data", deps(//autonomy:resource-source-layer))))',
    scope = [":resource-source-layer"],
)

genquery(
    name = "sustained_controller_host_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:sustained-controller-host)) union labels("data", deps(//autonomy:sustained-controller-host))))',
    scope = [":sustained-controller-host"],
)

genquery(
    name = "sustained_checkpoint_retention_host_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:sustained-checkpoint-retention-host)) union labels("data", deps(//autonomy:sustained-checkpoint-retention-host))))',
    scope = [":sustained-checkpoint-retention-host"],
)

genquery(
    name = "sustained_pilot_retention_host_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:sustained-pilot-retention-host)) union labels("data", deps(//autonomy:sustained-pilot-retention-host))))',
    scope = [":sustained-pilot-retention-host"],
)

genquery(
    name = "native_cache_retention_host_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy:native-cache-retention-host)) union labels("data", deps(//autonomy:native-cache-retention-host))))',
    scope = [":native-cache-retention-host"],
)

perception_py_test(
    "source_snapshot_targets_test.py",
    PERCEPTION_RUNFILES,
    extra_data = [
        ":native_cache_retention_host_query",
        ":resource_source_layer_query",
        ":sustained_checkpoint_retention_host_query",
        ":sustained_controller_host_query",
        ":sustained_pilot_retention_host_query",
        ":sustained_run_sources_query",
    ],
    deps = PERCEPTION_DEPS,
)

[
    perception_py_test(
        src,
        PERCEPTION_RUNFILES,
        extra_data = PERCEPTION_EXTRA_DATA.get(src, []),
        deps = PERCEPTION_DEPS,
    )
    for src in PERCEPTION_TEST_MODULES
]

test_suite(
    name = "perception_unit_tests",
    tests = [":source_snapshot_targets_test"]
        + [":" + perception_test_name(src) for src in PERCEPTION_TEST_MODULES]
        + [
            "//autonomy/camera:all_tests",
            "//autonomy/dataset:all_tests",
            "//autonomy/detection:all_tests",
            "//autonomy/evidence:all_tests",
            "//autonomy/geometry:all_tests",
            "//autonomy/inspection:all_tests",
            "//autonomy/insula:all_tests",
            "//autonomy/range_view:all_tests",
            "//autonomy/segmentation:all_tests",
        ],
    visibility = ["//visibility:public"],
)
