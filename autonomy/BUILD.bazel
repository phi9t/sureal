genquery(
    name = "sustained_run_sources_query",
    expression = 'kind("source file", filter("^//", labels("srcs", deps(//autonomy/training_execution:train_sustained)) union labels("data", deps(//autonomy/training_execution:train_sustained))))',
    scope = ["//autonomy/training_execution:train_sustained"],
)

