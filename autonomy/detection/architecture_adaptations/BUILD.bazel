load("@rules_python//python:defs.bzl", "py_library", "py_test")

LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py"],
)

TEST_MODULES = glob(["*_test.py"])

GPU_TESTS = [
    "models_test.py",
    "point_modules_test.py",
    "sparse_sets_test.py",
]

package(default_visibility = ["//visibility:private"])

py_library(
    name = "architecture_adaptations",
    srcs = LIB_MODULES,
    imports = ["../.."],
    visibility = [
        "//autonomy:__pkg__",
        "//autonomy/studies:__pkg__",
    ],
    deps = [
        "//autonomy/detection:detection",
        "//autonomy/range_view:range_view",
    ],
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = [
        "//autonomy:__pkg__",
        "//autonomy/studies:__pkg__",
    ],
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        deps = [":architecture_adaptations"],
        imports = ["../.."],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (["requires_gpu"] if test in GPU_TESTS else []),
    )
    for test in TEST_MODULES
]

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
    visibility = ["//autonomy:__pkg__"],
)
