load("@rules_python//python:defs.bzl", "py_library", "py_test")

TEST_MODULES = glob(["*_test.py"])
GPU_TESTS = [
    "camera_interpolation_parity_test.py",
]
LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py", "*_test_fixtures.py", "*_test_support.py", "oriented_box.py"],
)
GEOMETRY_VISIBILITY = [
    "//autonomy:__pkg__",
    "//autonomy/range_view:__pkg__",
    "//autonomy/studies:__pkg__",
    "//autonomy/motion:__pkg__",
    "//autonomy/inspection:__pkg__",
    "//autonomy/training_execution:__pkg__",
]
ORIENTED_BOX_VISIBILITY = GEOMETRY_VISIBILITY + [
    "//autonomy/detection:__pkg__",
    "//autonomy/evaluation:__pkg__",
    "//autonomy/segmentation:__pkg__",
]

TEST_EXTRA_SRCS = {
    "scientific_scene_command_test.py": ["scientific_reconstruction_test.py"],
    "scientific_scene_validate_test.py": ["scientific_reconstruction_test.py"],
}
TEST_DEPS = {
    "oriented_box_test.py": [":oriented_box"],
    "oriented_box_test_support_test.py": [":oriented_box_parity_harness"],
}

package(default_visibility = ["//visibility:private"])

py_library(
    name = "geometry",
    srcs = LIB_MODULES,
    imports = [".."],
    visibility = GEOMETRY_VISIBILITY,
    deps = [
        "//autonomy/blob_store:blob_store",
        "//autonomy/dataset:dataset",
        "//autonomy/evidence:evidence",
        "//autonomy/insula:insula",
        "//autonomy/resources:resources",
    ],
)

py_library(
    name = "oriented_box",
    srcs = ["oriented_box.py"],
    imports = [".."],
    visibility = ORIENTED_BOX_VISIBILITY,
)

py_library(
    name = "oriented_box_parity_harness",
    srcs = ["oriented_box_test_support.py"],
    imports = [".."],
    testonly = True,
    visibility = ORIENTED_BOX_VISIBILITY,
    deps = [":oriented_box"],
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

py_library(
    name = "native_range_shape_test_fixtures",
    srcs = ["native_range_shape_test_fixtures.py"],
    imports = [".."],
    testonly = True,
    visibility = ["//visibility:private"],
)

[
    py_test(
        name = test[:-3],
        srcs = [test] + TEST_EXTRA_SRCS.get(test, []),
        deps = TEST_DEPS.get(test, [":geometry"] + (
            [":native_range_shape_test_fixtures"]
            if test in [
                "native_range_shape_file_test.py",
                "native_range_shape_reference_test.py",
                "native_range_shape_worker_test.py",
            ]
            else []
        )),
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (["requires_gpu"] if test in GPU_TESTS else []),
    )
    for test in TEST_MODULES
]

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
    visibility = ["//autonomy:__pkg__"],
)
