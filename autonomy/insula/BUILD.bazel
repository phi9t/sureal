load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

TEST_MODULES = glob(["*_test.py"])
INSULA_VISIBILITY = ["//autonomy:__pkg__"]

package(default_visibility = INSULA_VISIBILITY)

exports_files([
    "entry.py",
    "m0_probe.py",
    "m0_receipt.py",
    "m0_validate.py",
    "runtime_identity.py",
    "sandbox_plan.py",
    "staging_lease.py",
], visibility = INSULA_VISIBILITY)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["**/__pycache__/**"],
    ),
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        data = [
            ":all_py",
            "//autonomy/evidence:all_py",
        ],
        imports = [".."],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (["requires_live_gate"] if test == "m0_receipt_test.py" else []),
    )
    for test in TEST_MODULES
]

cc_test(
    name = "rootfs_compiler_smoke_test",
    srcs = ["rootfs_compiler_smoke_test.cc"],
)

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
)
