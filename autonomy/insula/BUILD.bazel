load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

TEST_MODULES = glob(["*_test.py"])
LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py"],
)
INSULA_VISIBILITY = [
    "//autonomy:__pkg__",
    "//autonomy/dataset:__pkg__",
    "//autonomy/detection:__pkg__",
]

package(default_visibility = ["//visibility:private"])

py_library(
    name = "insula",
    srcs = LIB_MODULES,
    imports = [".."],
    deps = ["//autonomy/evidence:evidence"],
    visibility = INSULA_VISIBILITY,
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "host_entry_runtime_py",
    srcs = [
        "entry.py",
        "runtime_identity.py",
    ],
    visibility = ["//autonomy:__pkg__"],
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        deps = [":insula"],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (["requires_live_gate"] if test == "m0_receipt_test.py" else []),
    )
    for test in TEST_MODULES
]

cc_test(
    name = "rootfs_compiler_smoke_test",
    srcs = ["rootfs_compiler_smoke_test.cc"],
)

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
    visibility = ["//autonomy:__pkg__"],
)
