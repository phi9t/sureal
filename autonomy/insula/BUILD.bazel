load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

GPU_ROOTFS_BUILD_TEST = "build_gpu_bazel_rootfs_v6_test.py"

TEST_MODULES = glob(
    ["*_test.py"],
    exclude = [GPU_ROOTFS_BUILD_TEST],
)
LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py"],
)
INSULA_VISIBILITY = [
    "//autonomy:__pkg__",
    "//autonomy/camera:__pkg__",
    "//autonomy/dataset:__pkg__",
    "//autonomy/detection:__pkg__",
    "//autonomy/evaluation:__pkg__",
    "//autonomy/geometry:__pkg__",
    "//autonomy/resources:__pkg__",
    "//autonomy/retention:__pkg__",
    "//autonomy/motion:__pkg__",
    "//autonomy/inspection:__pkg__",
    "//autonomy/segmentation:__pkg__",
    "//autonomy/studies:__pkg__",
    "//autonomy/training_execution:__pkg__",
]

TEST_EXTRA_DATA = {
    "bazel_wrapper_test.py": [
        "//:MODULE.bazel",
        "//:MODULE.bazel.lock",
        "//:bazelw",
    ],
    "cpu_rootfs_build_test.py": ["//autonomy:cpu_rootfs_recipe"],
}

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "build_cpu_rootfs.sh",
        "cpu-test-tools-requirements.in",
        "cpu-test-tools-requirements.lock",
    ],
    visibility = ["//autonomy:__pkg__"],
)

py_library(
    name = "insula",
    srcs = LIB_MODULES,
    imports = [".."],
    deps = ["//autonomy/evidence:evidence"],
    visibility = INSULA_VISIBILITY,
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "host_entry_runtime_py",
    srcs = [
        "entry.py",
        "runtime_identity.py",
    ],
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "gpu_runtime_recipe",
    srcs = [
        "Dockerfile.gpu",
        "Dockerfile.gpu-bazel-rootfs-v6",
        "build_gpu.sh",
        "build_gpu_bazel_rootfs_v6.sh",
        "gpu-requirements.in",
        "gpu-requirements.lock",
    ],
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "cpu_rootfs_dockerfile",
    srcs = ["Dockerfile"],
    visibility = ["//autonomy:__pkg__"],
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        data = TEST_EXTRA_DATA.get(test, []),
        deps = [":insula"],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (
            ["requires_live_gate"]
            if test in ["m0_receipt_test.py", "launch_plan_live_test.py"]
            else []
        ) + (
            ["requires_gpu"]
            if test in ["launch_plan_gpu_live_test.py"]
            else []
        ),
    )
    for test in TEST_MODULES
]

py_test(
    name = GPU_ROOTFS_BUILD_TEST[:-3],
    srcs = [GPU_ROOTFS_BUILD_TEST],
    data = [":gpu_runtime_recipe"],
    deps = [
        ":insula",
        "//autonomy/evidence:evidence",
    ],
    legacy_create_init = 0,
    size = "small",
    tags = ["perception_unit"],
)

cc_test(
    name = "rootfs_compiler_smoke_test",
    srcs = ["rootfs_compiler_smoke_test.cc"],
)

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES] + [GPU_ROOTFS_BUILD_TEST[:-3]],
    visibility = ["//autonomy:__pkg__"],
)
