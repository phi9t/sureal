# Local base image ID; build driver must verify this exact image exists.
FROM surflo-insula:cuda13.2.1-locked
COPY gpu-requirements.lock /opt/waymo-requirements.lock
RUN uv venv --python /usr/bin/python3 /opt/waymo \
 && uv pip install --python /opt/waymo/bin/python --require-hashes \
    --extra-index-url https://download.pytorch.org/whl/cu130 \
    --index-strategy unsafe-best-match -r /opt/waymo-requirements.lock \
 && mkdir -p /experiment /source /outputs /driver \
 && /opt/waymo/bin/python -c 'import torch, importlib.util; assert torch.__version__ == "2.9.1+cu130"; assert importlib.util.find_spec("tensorflow") is None'
ENV PATH=/opt/waymo/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
ENTRYPOINT []
