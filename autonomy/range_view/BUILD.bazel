load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py"],
)

TEST_MODULES = glob(["*_test.py"])

GPU_TESTS = [
    "range_frontend_test.py",
    "range_fusion_test.py",
    "range_pillar_hybrid_test.py",
    "sparse_window_attention_test.py",
]

RANGE_VIEW_VISIBILITY = [
    "//autonomy:__pkg__",
    "//autonomy/detection/expanded_batch:__pkg__",
    "//autonomy/gpu:__pkg__",
    "//autonomy/studies:__pkg__",
    "//autonomy/training_execution:__pkg__",
]

TEST_EXTRA_DEPS = {
    "range_fusion_test.py": ["//autonomy/detection:detection"],
    "range_pillar_hybrid_test.py": ["//autonomy/detection:detection"],
}

py_library(
    name = "range_view",
    srcs = LIB_MODULES,
    imports = [".."],
    visibility = RANGE_VIEW_VISIBILITY,
    deps = [
        "//autonomy/detection:detection",
    ],
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        deps = [":range_view"] + TEST_EXTRA_DEPS.get(test, []),
        imports = [".."],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"] + (["requires_gpu"] if test in GPU_TESTS else []),
    )
    for test in TEST_MODULES
]

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
    visibility = ["//autonomy:__pkg__"],
)
