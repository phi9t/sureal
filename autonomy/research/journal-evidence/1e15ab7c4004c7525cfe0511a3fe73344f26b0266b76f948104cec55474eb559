visiting, done = set(), set()
def visit(node):
    assert node not in visiting, node
    if node in done:
        return
    visiting.add(node)
    for predecessor in graph[node]:
        visit(predecessor)
    visiting.remove(node)
    done.add(node)
for node in graph:
    visit(node)
