        assert row['absence'] in allowed_absence[row['phase']], (ticket, row['id'], row['absence'])
        assert row['phase'] in ('gate', 'post-landing', 'closure')
        assert row['candidate_roles'] == ['all'] or set(row['candidate_roles']) <= set(expected_roles[ticket])
