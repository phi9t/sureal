# This is the declared dependency graph, not a live scheduler observation.
graph = {'49': [], '50': ['49'], '51': ['50'], '52': ['51'], '53.0': ['52'],
         '54': ['49', '50', '51', '52', '53.0'], '53': ['52', '53.0', '54'],
