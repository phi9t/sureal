        "import json,hashlib,numpy as np\nfrom pathlib import Path\nfrom pipeline.semantic_support import semantic_support\nd=json.loads(Path('/mnt/trusted.json').read_text());report=Path('/source/points/report.json');assert hashlib.sha256(report.read_bytes()).hexdigest()==d['report_sha256'];r=json.loads(report.read_text());reference=[0]*23;used=[]\ndef records():\n for row in r['rows']:\n  identity={k:row[k] for k in ('context','timestamp','laser','return')};entry={'identity':identity,'return_present':row['return_present'],'observations':{},'targets':{}}\n  if row['segmentation_present']:\n   path=Path('/source/points')/row['artifact'];assert path.stat().st_size<=128*1024**2;assert hashlib.sha256(path.read_bytes()).hexdigest()==row['sha256']\n   with np.load(path,allow_pickle=False) as x:\n    xyz=x['xyz'].copy();labels=x['segmentation'].copy();assert xyz.shape==(row['points'],3) and labels.shape==(row['points'],2);entry['observations']['xyz']=xyz;entry['targets']['segmentation']=labels\n   for label in labels[:,1]:reference[int(label)]+=1\n   used.append((path,row['sha256']))\n  yield entry\nresult=semantic_support(records());assert result['native_counts']==reference\nfor path,h in used:assert hashlib.sha256(path.read_bytes()).hexdigest()==h\nresult['scene']=d['scene'];result['membership']=d['membership'];result['source_report_sha256']=d['report_sha256'];Path('/outputs/support.json').write_text(json.dumps(result,indent=2));print('PASS native valid-range semantic support',d['scene'],result['eligible_point_elements'])\n"
