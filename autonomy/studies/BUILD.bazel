load("@rules_python//python:defs.bzl", "py_library", "py_test")

ACTIVE_MODULES = [
    "architecture/experiment_runner.py",
    "expanded_batch/expanded_verifier.py",
    "fixed_batch/fixed_batch_verifier.py",
]

ACTIVE_TESTS = [
    "architecture/experiment_runner_test.py",
    "expanded_batch/expanded_verifier_test.py",
]

ARCHITECTURE_RUNFILES = glob([
    "architecture/*.json",
    "architecture/harness/*",
])

PROCEDURE_RECORDS = glob([
    "expanded_batch/procedure_records/*.py",
    "fixed_batch/procedure_records/*.py",
])

package(default_visibility = ["//visibility:private"])

exports_files(
    ["architecture/experiment_runner.py"],
    visibility = ["//autonomy:__pkg__"],
)

py_library(
    name = "studies",
    srcs = ACTIVE_MODULES,
    imports = [".."],
    visibility = [
        "//autonomy:__pkg__",
        "//autonomy/cohort:__pkg__",
        "//autonomy/resources:__pkg__",
    ],
    deps = [
        "//autonomy/evidence:evidence",
        "//autonomy/resources:resources",
    ],
)

filegroup(
    name = "architecture_runfiles",
    srcs = ARCHITECTURE_RUNFILES + glob(["architecture/ideas/*.md"]),
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "procedure_records",
    srcs = PROCEDURE_RECORDS,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runfiles",
    srcs = ARCHITECTURE_RUNFILES + PROCEDURE_RECORDS + glob(["**/*.md"]),
    visibility = ["//autonomy:__pkg__"],
)

[
    py_test(
        name = test[:-3].replace("/", "__"),
        srcs = [test],
        data = [":architecture_runfiles"],
        deps = [
            ":studies",
            "//autonomy/resources:resources",
        ],
        imports = [".."],
        legacy_create_init = 0,
        main = test,
        size = "small",
        tags = ["perception_unit"],
    )
    for test in ACTIVE_TESTS
]

test_suite(
    name = "all_tests",
    tests = [test[:-3].replace("/", "__") for test in ACTIVE_TESTS],
    visibility = ["//autonomy:__pkg__"],
)
