load("@rules_python//python:defs.bzl", "py_library", "py_test")

TEST_MODULES = glob(["*_test.py"])
LIB_MODULES = glob(
    ["*.py"],
    exclude = ["*_test.py"],
)

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "sustained_contract.py",
        "sustained_scoring_budget.py",
    ],
    visibility = ["//autonomy:__pkg__"],
)

py_library(
    name = "sustained",
    srcs = LIB_MODULES,
    imports = [".."],
    visibility = [
        "//autonomy:__pkg__",
        "//autonomy/evaluation:__pkg__",
        "//autonomy/training_execution:__pkg__",
    ],
)

filegroup(
    name = "all_py",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

filegroup(
    name = "runfiles",
    srcs = glob(["*.py"]),
    visibility = ["//autonomy:__pkg__"],
)

[
    py_test(
        name = test[:-3],
        srcs = [test],
        deps = [":sustained"],
        imports = [".."],
        legacy_create_init = 0,
        size = "small",
        tags = ["perception_unit"],
    )
    for test in TEST_MODULES
]

test_suite(
    name = "all_tests",
    tests = [test[:-3] for test in TEST_MODULES],
    visibility = ["//autonomy:__pkg__"],
)
