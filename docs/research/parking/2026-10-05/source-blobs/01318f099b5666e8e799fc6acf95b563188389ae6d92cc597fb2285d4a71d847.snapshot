import pathlib,json,sys,subprocess,hashlib,shutil,time
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from advanced.archive import sha
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-pooled-finite-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/test_motion_pooled_finite.py',code/'test_finite.py');shutil.copy(P/'motion-evaluation/ingestion/pooled_handoff_check.py',code/'check.py');root=C/'insula/rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);source=C/'insula/motion-real-pooled-v1/native';parent=P/'research/motion-real-pooled-metric-verified.json';receipt=json.loads(parent.read_text());assert all(sha(p)==h for p,h in receipt['artifacts'].items());out=R/'red';out.mkdir();cmd=launch_plan(root,code,source,out,['python','/experiment/test_finite.py']);r=subprocess.run(cmd,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==1 and 'ValueError not raised' in r.stderr;record={'command':cmd,'exit_code':1,'expected_exit_code':1,'runtime_lock':lock,'parent_pooled_receipt_sha256':sha(parent),'pins':{str(p):sha(p) for p in code.iterdir()},'artifacts':{str(p):sha(p) for p in out.iterdir()},'scope':'live RED: nonfinite observed/reference displacements admitted by previous comparator'};(P/'research/motion-pooled-finite-red-verified.json').write_text(json.dumps(record,indent=2));print(r.stderr)
