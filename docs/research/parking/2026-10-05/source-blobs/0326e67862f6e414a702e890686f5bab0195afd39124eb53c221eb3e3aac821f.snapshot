import pathlib,json,sys,subprocess,hashlib,shutil,os,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from tier1.storage import unique_payload_bytes
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-delta-native-verify-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_delta_native_verify.cc',code/'verify.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');os.link(C/'insula/motion-native-link-v5/output/observations.pb',code/'training.pb');os.link(C/'insula/motion-validation-native-link-v1/output/observations.pb',code/'validation.pb');W=C/'scientific-processing/motion-delta-components-v1';assert unique_payload_bytes(W)<512*1024**2 and unique_payload_bytes(C/'scientific-processing')<15*1024**3;root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for p in code.iterdir()};checks=[];start=time.monotonic()
for split in ['training','validation']:
 out=R/split;out.mkdir();command=launch_plan(root,code,W,out,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/verify.cc /motion-build/libwod_motion_proto.a -lprotobuf -lz -pthread -o /outputs/verify && /outputs/verify /experiment/'+split+'.pb /source/'+split+' /outputs']);r=subprocess.run(command,capture_output=True,text=True,timeout=180);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;assert (out/'components.tsv').read_bytes()==(W/split/'components.tsv').read_bytes();checks.append({'command':command,'exit_code':0});print(r.stdout)
assert all(sha(p)==h for p,h in pins.items());receipt={'checks':checks,'runtime_lock':lock,'pins':pins,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'component_payload_bytes':unique_payload_bytes(W),'component_cap_bytes':512*1024**2,'scientific_payload_bytes':unique_payload_bytes(C/'scientific-processing'),'scientific_cap_bytes':15*1024**3,'artifacts':{str(p):sha(p) for p in W.rglob('*') if p.is_file()},'scope':'live native source reparse and exact retained delta bytes/scalar dequant checksums; NumPy reconciliation/XYZ geometry pending; prior256MiB admission failed'};(P/'research/motion-delta-native-components-verified.json').write_text(json.dumps(receipt,indent=2))
