import pathlib,json,sys,subprocess,hashlib,shutil,os,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from tier1.storage import unique_payload_bytes
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-delta-native-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_delta_native.cc',code/'native.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');inputs=R/'inputs';inputs.mkdir();os.link(C/'insula/motion-native-link-v5/output/observations.pb',inputs/'training.pb');os.link(C/'insula/motion-validation-native-link-v1/output/observations.pb',inputs/'validation.pb');W=C/'scientific-processing/motion-delta-components-v1';assert unique_payload_bytes(C/'scientific-processing')+256*1024**2<15*1024**3;W.mkdir();root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for folder in [code,inputs] for p in folder.iterdir()};checks=[];start=time.monotonic()
for split in ['training','validation']:
 out=W/split;out.mkdir();command=launch_plan(root,code,inputs,out,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/native.cc /motion-build/libwod_motion_proto.a -lprotobuf -lz -pthread -o /outputs/native && /outputs/native /source/'+split+'.pb /outputs']);r=subprocess.run(command,capture_output=True,text=True,timeout=180);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks.append({'command':command,'exit_code':0});assert unique_payload_bytes(W)<256*1024**2 and unique_payload_bytes(C/'scientific-processing')<15*1024**3;print(r.stdout)
assert all(sha(p)==h for p,h in pins.items());receipt={'checks':checks,'runtime_lock':lock,'pins':pins,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for p in W.rglob('*') if p.is_file()},'scope':'native complete historical delta metadata/components and independent scalar dequant checksums; NumPy reconciliation and XYZ geometry pending'};(P/'research/motion-delta-native-components-verified.json').write_text(json.dumps(receipt,indent=2))
