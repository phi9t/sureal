"""Streaming joins must preserve point identity, native extent and missing support."""
import copy,unittest
import numpy as np
from point_grid_linkage import validate_linkage
class LinkageTests(unittest.TestCase):
 def fixture(self):
  identity={'context':'scene','timestamp':10,'laser':1,'return':1,'motion':'compensated','pixels':np.array([[0,0],[1,3]],dtype=np.int64)}
  records=[{'identity':identity,'return_present':True,'observations':{'physical_features':np.array([[2.,.2,.3],[4.,.5,.6]]),'xyz':np.ones((2,3))},'targets':{'segmentation':np.array([[-1,14],[0,0]],dtype=np.int64)},'evaluation':{'nlz':np.array([-1,1])},'correspondence':{}}]
  shapes=[{'context':'scene','timestamp':10,'laser':1,'return':r,'native_shape':[3,5,4] if r==1 else None} for r in [1,2]]
  records.append({'identity':dict(context='scene',timestamp=10,laser=1,**{'return':2}), 'return_present':False,'observations':{},'targets':{},'evaluation':{},'correspondence':{}})
  return records,shapes
 def test_valid_points_empty_border_and_missing_return(self):
  records,shapes=self.fixture();v=validate_linkage(iter(records),shapes)
  self.assertEqual(v['records'],2);self.assertEqual(v['points'],2)
  self.assertEqual(v['eligible_semantic_points'],1);self.assertEqual(v['absent_returns'],1)
  self.assertEqual(v['native_grid_cells'],15)
 def test_present_empty_is_distinct_from_absent(self):
  records,shapes=self.fixture();r=records[0];r['identity']['pixels']=np.empty((0,2),dtype=np.int64);r['observations']['physical_features']=np.empty((0,3));r['observations']['xyz']=np.empty((0,3));r['targets']={};r['evaluation']={}
  v=validate_linkage(iter(records),shapes);self.assertEqual(v['present_empty_returns'],1);self.assertEqual(v['absent_returns'],1)
 def test_missing_extra_duplicate_and_invalid_native_grid_refused(self):
  for mutation in ['missing','duplicate','out_of_grid','duplicate_pixel','null_present_shape','extra_shape']:
   with self.subTest(mutation=mutation):
    records,shapes=self.fixture()
    if mutation=='missing':records.pop()
    elif mutation=='duplicate':records.append(copy.deepcopy(records[0]))
    elif mutation=='out_of_grid':records[0]['identity']['pixels'][1]=[3,0]
    elif mutation=='duplicate_pixel':records[0]['identity']['pixels'][1]=[0,0]
    elif mutation=='null_present_shape':shapes[0]['native_shape']=None
    else:shapes.append(dict(shapes[0],timestamp=11))
    with self.assertRaises(ValueError):validate_linkage(iter(records),shapes)
if __name__=='__main__':unittest.main()
