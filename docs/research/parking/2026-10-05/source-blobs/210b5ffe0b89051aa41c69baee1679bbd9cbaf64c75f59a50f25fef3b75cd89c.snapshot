from pathlib import Path
import json,hashlib
code=Path('experiments/waymo-perception');r=code/'research';sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
cohort=json.loads((code/'scientific-cohort.candidate.json').read_text())
files=['scientific-cohort.candidate.json','scientific-acquisition.candidate.json','evaluation/contracts.json','research/training-anchor-templates.candidate.json','research/training-anchor-candidate-verified.json','research/detector-optimizer-resource-audit-verified.json',*[str(p.relative_to(code)) for p in sorted((code/'pipeline').glob('*.py'))]]
d={'schema_version':1,'status':'candidate; not authorized for scientific execution until independent native pilot and ticket07 gates pass','study':'current-frame PointPillars Waymo adaptation; encoder comparisons need separate matched-head preregistration','pins':{p:sha(code/p) for p in files},'cohorts':cohort['cohorts'],'excluded_engineering_segments':cohort['excluded_engineering_segments'],'seeds':[17,29,43],
'observations':{'time':'current frame only','lasers':[1,2,3,4,5],'returns':[1,2],'features':['vehicle_x','vehicle_y','vehicle_z','intensity'],'top_motion_compensation':'native per-pixel and frame reference','short_lidar_motion_compensation':'static extrinsics to native vehicle reference; no invented per-pixel poses','excluded_features':['NLZ','semantic_label','object_id','difficulty','box_point_count'],'roi_half_open':[-64,-64,-4,64,64,6],'cell_size':[.25,.25],'max_pillars':20000,'max_points_per_pillar':32,'packing':'seeded PCG64 selected cell IDs and retained original point indices; preserve measurement-key sidecars','physical_dtype':'float64 reconstruction cast to float32 encoder','roi_rationale':'declared bounded128m square at measured512-cell layout; not full sensor coverage or a training-data quantile'},
'model':{'classes':[1,2,3,4],'anchors_per_cell':8,'anchor_templates':'research/training-anchor-templates.candidate.json','padding':'source-style padded-slot BN','head':'existing stride-two shared anchor head; class order native1..4','assignment':{'similarity':'nearest-axis-aligned BEV IoU','positive':.5,'negative':.35,'forced':'all tied positive best-overlap anchors; zero-overlap GT not forced','subsampling':False,'anchor_pruning':False},'loss':'pinned detector_loss.py: focal alpha.25 gamma2; smoothL1 beta1/9 sine-yaw; weights1/2/.2; per-frame positive normalization','decode':{'score_floor':.05,'iou_threshold':.5,'pre_limit':4096,'post_limit':500,'nms':'class-agnostic enclosing BEV; original anchor index breaks score ties'}},
'optimization':{'optimizer':'Adam','learning_rate':1e-4,'betas':[.9,.999],'eps':1e-8,'weight_decay':0,'foreach':False,'batch_size':1,'updates':20000,'precision':'float32; TF32 disabled','gradient_clip_norm':10,'data_order':'per-epoch seeded shuffle of all selected train frame keys; deterministic packing seed from run seed, epoch and frame key','checkpoint_interval':2000,'selection':'highest development macro4-class LEVEL_2 APH; earliest update breaks ties; validation opened once per selected seed checkpoint','training_targets':'native boxes with centers in half-open ROI; dimensions not clipped; unknown and evaluator-ineligible zero-point boxes excluded; record every excluded target'},
'overfit_gate':{'training_frames':16,'selection':'first16 train frame keys under SHA256 overfit-v1:segment:timestamp order; no dev/validation','seed':17,'max_updates':2000,'loss_reduction_fraction':.8,'minimum_APH':.8,'scope':'training-only ROI-center eligible targets, populated classes reported individually; mean eligible APH threshold; no heldout quality inference','required':'finite losses/gradients, input-label isolation, exact export and independent native scoring'},
'evaluation':{'primary':'macro mean native pooled LEVEL_2 APH over vehicle,pedestrian,sign,cyclist; report all per-class AP/APH and LEVEL_1/RANGE','heldout_GT':'all original native validation targets under pinned evaluator; do not remove GT outside model ROI or sampling support','missing_class':'report absence and undefined primary; never drop class to fabricate a score','uncertainty':{'unit':'whole segment','confidence':.95,'bootstrap_replicates':10000,'bootstrap_seed':20260930,'pooled_metric':'rerun pooled native evaluator on each segment bootstrap; do not average segment AP'},'baseline_decision':'accept reference only when implementation/overfit/full heldout receipts and resource gates pass; no improvement claim from baseline alone'},
'resource_limits':{'local_raw_bytes':2147483648,'local_scientific_working_bytes':16106127360,'peak_cuda_allocated_bytes':8589934592,'peak_worker_rss_bytes':17179869184,'reserved_device_hours_per_seed':24,'reserved_device_hours_overfit':2,'accounting':'include training I/O idle reservation, development selection and validation; stop and retain failure on cap, no silent update-budget reduction'},
'pre_execution_gates':['complete independently admitted103-scene point/grid support','native training-only full observation/target join and exclusion counts','native optimizer/assignment/export resource pilot under this candidate','tiny overfit gate independently live validated','candidate-specific independent live protocol admission','ticket07 acceptance for affected study'],
'limitations':['anchor medians weight repeated frame/object rows; cyclist38 unique training tracks','class-agnostic enclosing NMS and shared head are declared adaptations','synthetic timing does not predict native end-to-end training cost','this draft does not freeze segmentation, camera, mask transfer or Motion studies']}
p=r/'pointpillars-scientific-protocol.candidate.json';assert not p.exists();p.write_text(json.dumps(d,indent=2)+'\n');print('WROTE',p)
