import json,shutil,subprocess,sys
from pathlib import Path
P=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from tracking.journal import digest
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/research-tracker-live-v2';R.mkdir();source=R/'source';source.mkdir();shutil.copytree(P/'tracking',source/'tracking',ignore=shutil.ignore_patterns('__pycache__'));fixture=R/'fixture';fixture.mkdir();(fixture/'proof.json').write_text('{"all_passed":true}');point={'step':500,'LEVEL2_per_class':{str(i):{'APH':.9} for i in range(1,5)},'all_class_quality_passed':True};(fixture/'run').mkdir();(fixture/'run/run.json').write_text(json.dumps({'matrix':{'baseline':{}}}));results={'run_directory':'/source/run','metadata_sha256':digest(fixture/'run/run.json'),'finished':True,'cases':{'baseline':{'status':'sustained native overfit','updates':750,'curve':[point,{**point,'step':750}]}}};(fixture/'results.json').write_text(json.dumps(results));closure={'candidate_sha256':digest(fixture/'results.json'),'validation':{'all_cases_finished':True},'checks':[{'exit_code':0}],'artifacts':{'/source/proof.json':digest(fixture/'proof.json')}};(fixture/'closure.json').write_text(json.dumps(closure));(fixture/'admission.json').write_text(json.dumps({'cases':{'range_fusion':{'validation':{'case':{},'exact_repeated_three_update_model_adam_rng':True}}}}));registry={'runs':[{'id':'fixture','results':'results.json','closure':'closure.json','recipes':{'baseline':{}}},{'id':'fixture2','results':'missing.json','closure':'missing-closure.json','admission':'admission.json','recipes':{'range_fusion':{}}}]};(fixture/'registry.json').write_text(json.dumps(registry));root=C/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);out=R/'output';out.mkdir();pins={str(p):digest(p) for p in source.rglob('*') if p.is_file()};command=launch_plan(root,source,fixture,out,['python','/experiment/tracking/live_contract.py']);result=subprocess.run(command,capture_output=True,text=True,timeout=300);(out/'live.log').write_text(result.stdout+result.stderr);assert result.returncode==0,result.stderr;assert all(digest(p)==h for p,h in pins.items());receipt={'command':command,'exit_code':0,'source_pins':pins,'runtime_lock':lock,'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):digest(p) for p in out.rglob('*') if p.is_file()}};(P/'research/research-tracker-live-verified.json').write_text(json.dumps(receipt,indent=2));print(result.stdout)
