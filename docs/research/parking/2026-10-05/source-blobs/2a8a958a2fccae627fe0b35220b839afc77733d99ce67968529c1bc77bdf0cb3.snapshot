#!/usr/bin/env python3
"""Retain actual collaboration gate probes; only an independent audit accepts them."""
import importlib.util
from pathlib import Path
import sys
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
spec = importlib.util.spec_from_file_location('collab_live_support', ROOT/'tests/collab/live_support.py')
support = importlib.util.module_from_spec(spec)
spec.loader.exec_module(support)

if __name__ == '__main__':
    raise SystemExit(support.main())
