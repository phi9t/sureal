 assert sha(worker)==digest and sha(candidate)==candidate_sha;receipt={'checks':checks,'runtime_lock':lock,'selection_sha256':candidate_sha,'worker_sha256':digest,'transfer':transfer,'artifacts':{str(p):sha(p) for p in directory.rglob('*') if p.is_file()},'validation':json.loads((directory/'reference/check.json').read_text())};(directory/'receipt.json').write_text(json.dumps(receipt,indent=2));complete.append({'scene':scene,'receipt':str(directory/'receipt.json'),'sha256':sha(directory/'receipt.json')});(PACKAGE/'research/balanced16-camera-preview-progress.json').write_text(json.dumps({'expected_scenes':13,'admitted_scenes':len(complete),'scene_receipts':complete},indent=2)+'\n');print('ADMITTED CAMERA PREVIEWS',scene,flush=True)
