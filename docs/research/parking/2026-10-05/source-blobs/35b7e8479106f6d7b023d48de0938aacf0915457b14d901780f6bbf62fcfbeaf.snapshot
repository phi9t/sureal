  staged=Path(tmp);path=staged/'camera_image.parquet';command=['timeout','--kill-after=5s','120s','bash',str(PACKAGE/'gcs.sh'),'--','storage','cp',record['source_metadata']['storage_url'],str(path)]
  def cap():resource.setrlimit(resource.RLIMIT_FSIZE,(2*1024**3-retained,2*1024**3-retained))
  result=subprocess.run(command,capture_output=True,text=True,preexec_fn=cap);assert result.returncode==0,(scene,result.stderr);transfer={'command':command,'exit_code':0,'verification':verify_source(path,size_bytes=size,sha256=record['sha256'],md5_base64=record['source_metadata']['md5_hash'])}
  for mode in ['producer','reference']:
