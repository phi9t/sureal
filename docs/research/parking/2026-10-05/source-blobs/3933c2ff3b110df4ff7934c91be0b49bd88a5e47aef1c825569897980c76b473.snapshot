import json,hashlib,subprocess,sys
from pathlib import Path
exp=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(exp));from pipeline.runtime_identity import verify_rootfs
cache=Path.home()/'.cache/waystone/waymo-perception';slice_root=cache/'slices/validation-two-scenes-20260929';prior=json.loads((exp/'research/native-range-shapes-verified.json').read_text());old=Path(prior['receipt']).parent;sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();assert sha(old/'receipt.json')==prior['receipt_sha256'];assert sha(old/'output/shapes.json')==prior['artifacts']['output/shapes.json']
reference=json.loads((old/'output/shapes.json').read_text());manifest=json.loads((slice_root/'slice.json').read_text());obj=next(o for o in manifest['objects'] if o['component']=='lidar');records=[r for r in reference['rows'] if r['context']==obj['context']];digest=hashlib.sha256()
for r in records:
 if r['return']==1:digest.update((json.dumps(dict(zip(['key.segment_context_name','key.frame_timestamp_micros','key.laser_name'],[r['context'],r['timestamp'],r['laser']])),sort_keys=True,separators=(',',':'))+'\n').encode())
job={'scene':obj['context'],'membership':{'official_split':'validation','research_splits':['engineering']},'source':{k:obj[k] for k in ['size_bytes','sha256','md5_base64']},'inventory':{'rows':len(records)//2,'key_sha256':digest.hexdigest()}}
run=cache/'insula/native-shape-worker-cli-a';run.mkdir(exist_ok=False);(run/'input').mkdir();(run/'output').mkdir();(run/'audit').mkdir();j=run/'input/job.json';j.write_text(json.dumps(job,indent=2));job_sha=sha(j)
cmd0=prior['checks'][0]['command'];cmd0=cmd0[:cmd0.index('--')];verify_rootfs(Path(cmd0[4]),prior['runtime_lock']['rootfs_sha256']);cmd=cmd0.copy();cmd[cmd.index(str(old/'output'))]=str(run/'output');cmd+=['--ro-bind',str(run/'input'),'/tmp/job','--','python','-m','pipeline.native_range_shape_worker','/source/'+obj['relative_path'],'/tmp/job/job.json','/outputs/shapes.json','--expected-job-sha256',job_sha];ret=subprocess.run(cmd,capture_output=True,text=True);(run/'live.log').write_text(ret.stdout+ret.stderr);assert ret.returncode==0,ret.stderr
output_sha=sha(run/'output/shapes.json');audit=cmd0.copy();audit[audit.index(str(old/'output'))]=str(run/'audit');audit+=['--ro-bind',str(run/'input'),'/tmp/job','--ro-bind',str(run/'output'),'/tmp/replayed','--ro-bind',str(old/'output'),'/tmp/reference']
script="""import json,hashlib,math
from pathlib import Path
from pipeline.native_range_shape_reference import verify_native_range_shapes
job_path=Path('/tmp/job/job.json');assert hashlib.sha256(job_path.read_bytes()).hexdigest()==JOBSHA;job=json.loads(job_path.read_text());p=Path('/tmp/replayed/shapes.json');assert hashlib.sha256(p.read_bytes()).hexdigest()==OUTPUTSHA;r=json.loads(p.read_text());assert r['job_sha256']==JOBSHA and r['membership']==job['membership'] and r['source']==job['source'];actual=verify_native_range_shapes(SOURCE,r['shapes'],scene=job['scene'],source=job['source'],inventory=job['inventory']);assert actual==r['independent'];expected=[x for x in json.loads(Path('/tmp/reference/shapes.json').read_text())['rows'] if x['context']==job['scene']];assert r['shapes']['records']==expected;resources=r['worker_resources'];assert resources['rss_scope']=='worker_process_peak' and type(resources['peak_rss_kib']) is int and resources['peak_rss_kib']>0 and math.isfinite(resources['elapsed_seconds']) and resources['elapsed_seconds']>=0;Path('/outputs/check.json').write_text(json.dumps({'records_verified':len(expected),'worker_resources':resources,'scope':'independent native CLI output/source admission; original scientific103 pending'},indent=2));print('PASS independently admitted native worker CLI',len(expected))
""".replace('JOBSHA',repr(job_sha)).replace('OUTPUTSHA',repr(output_sha)).replace('SOURCE',repr('/source/'+obj['relative_path']))
audit+=['--','python','-c',script];checked=subprocess.run(audit,capture_output=True,text=True);(run/'audit/live.log').write_text(checked.stdout+checked.stderr);assert checked.returncode==0,checked.stderr
code_names=['native_range_shape_worker.py','native_range_shape_file.py','native_range_shapes.py','native_range_shape_reference.py','source_integrity.py'];d={'checks':[{'command':cmd,'exit_code':ret.returncode},{'command':audit,'exit_code':checked.returncode}],'runtime_lock':prior['runtime_lock'],'job_sha256':job_sha,'source_slice_manifest_sha256':sha(slice_root/'slice.json'),'reference_receipt_sha256':prior['receipt_sha256'],'code_sha256':{n:sha(exp/'pipeline'/n) for n in code_names},'script_sha256':sha(Path(__file__)),'validation':json.loads((run/'audit/check.json').read_text()),'artifacts':{str(p.relative_to(run)):sha(p) for p in sorted(run.rglob('*')) if p.is_file()},'scope':'one retained native engineering source actual isolated CLI and second-process admission; scientific replay pending'};(run/'receipt.json').write_text(json.dumps(d,indent=2));d['receipt']=str(run/'receipt.json');d['receipt_sha256']=sha(run/'receipt.json');(exp/'research/native-shape-worker-cli-verified.json').write_text(json.dumps(d,indent=2));print(ret.stdout,checked.stdout)
for n,h in d['artifacts'].items():assert sha(run/n)==h
