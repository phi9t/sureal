import hashlib,json
from pathlib import Path
import numpy as np
manifest=json.loads(Path('/tmp/manifest.json').read_text());predictions=json.loads(Path('/tmp/predictions.json').read_text());reports=[]
for index,frame in enumerate(manifest['frames']):
 scene,timestamp=frame['identity'].split(':');directory=Path('/tmp/native')/frame['relative_directory']
 for name,h in frame['sha256'].items():assert hashlib.sha256((directory/name).read_bytes()).hexdigest()==h
 with np.load(directory/'targets.npz',allow_pickle=False) as data:labels=data['labels'];targets=data['box_targets'];directions=data['direction_targets']
 with np.load(Path('/source')/('heads-%02d.npz'%index),allow_pickle=False) as data:logits=data['classification'].astype(float);residuals=data['box_residuals'].astype(float);dirlogits=data['direction'].astype(float)
 probabilities=np.exp(-np.logaddexp(0,-logits));scores=probabilities.max(1);classes=probabilities.argmax(1)+1;positive=labels>0
 selected=[r for r in predictions if r['context_name']==scene and r['frame_timestamp_micros']==int(timestamp)];selected_indices=np.array([int(r['object_id'].split('-')[-1]) for r in selected],dtype=np.int64)
 perclass={}
 for category in range(1,5):
  mask=labels==category;count=int(mask.sum())
  perclass[category]={'positive_anchors':count,'true_class_probability_quantiles':np.quantile(probabilities[mask,category-1],[0,.1,.5,.9,1]).tolist() if count else None,'classification_accuracy':float(np.mean(classes[mask]==category)) if count else None,'direction_accuracy':float(np.mean(dirlogits[mask].argmax(1)==directions[mask])) if count else None,'selected_positive_anchors':int(np.count_nonzero(labels[selected_indices]==category)),'positive_linear_residual_mae':np.mean(np.abs(residuals[mask,:6]-targets[mask,:6]),axis=0).tolist() if count else None}
 reports.append({'identity':frame['identity'],'per_class':perclass,'background_max_probability_quantiles':np.quantile(scores[labels==0],[0,.5,.9,.99,1]).tolist(),'background_above_floor':int(np.count_nonzero((labels==0)&(scores>=.05))),'exported_predictions':len(selected),'exported_positive_anchor_predictions':int(np.count_nonzero(labels[selected_indices]>0)),'selected_score_quantiles':np.quantile(scores[selected_indices],[0,.5,1]).tolist() if len(selected_indices) else None})
Path('/outputs/check.json').write_text(json.dumps({'scope':'observational final-head/target/ranking diagnostics; no model modification or quality acceptance','frames':reports},indent=2)+'\n');print('PASS observational head diagnostics',sum(r['exported_positive_anchor_predictions'] for r in reports),'positive-anchor predictions of',sum(r['exported_predictions'] for r in reports))
