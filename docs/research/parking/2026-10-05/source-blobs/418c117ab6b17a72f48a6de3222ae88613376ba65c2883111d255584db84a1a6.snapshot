import pathlib,json,sys,subprocess,shutil,os,time,resource,re
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from advanced.archive import sha
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-pilot-closeout-v2';R.mkdir();code=R/'code';code.mkdir();(code/'tests').mkdir();(code/'motion-evaluation/pooled').mkdir(parents=True);(code/'check_tensorflow.py').write_text("import importlib.util;assert importlib.util.find_spec('tensorflow') is None;print('TensorFlow absent')\n")
for src,dst in [('motion_causal_project.cc','project.cc'),('native_source_link_fixture.cc','prefix.cc'),('native_source_inventory.cc','native_source_inventory.cc')]:shutil.copy(P/'motion-evaluation/ingestion'/src,code/dst)
for name in ['test_motion_native_cli.py','test_motion_joint_cli.py','test_motion_causal_projection.py','test_motion_pooled_cli.py']:shutil.copy(P/'tests'/name,code/'tests'/name)
for name in ['CMakeLists.txt','motion_metrics_pooled_main.cc']:shutil.copy(P/'motion-evaluation/pooled'/name,code/'motion-evaluation/pooled'/name)
inputs=R/'inputs';inputs.mkdir();parents={}
for split,folder in [('training','motion-native-link-v5'),('validation','motion-validation-native-link-v1')]:
 parent=P/'research'/('motion-'+split+'-native-link-verified.json');p=json.loads(parent.read_text());assert p['exit_code']==0 and p['future_rejection_exit_code']!=0 and p['key_and_duplicate_refusals'];assert all(sha(x)==h for x,h in p['artifacts'].items());parents[str(parent)]=sha(parent);os.link(C/'insula'/folder/'output/merged.pb',inputs/(split+'.pb'))
root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);pins={str(p):sha(p) for directory in [code,inputs] for p in directory.rglob('*') if p.is_file()};out=R/'output';out.mkdir();checks=[];start=time.monotonic()
def execute(name,shell,expected=0):
 command=launch_plan(root,code,inputs,out,['/bin/sh','-c',shell]);r=subprocess.run(command,capture_output=True,text=True,timeout=180);(out/(name+'.log')).write_text(r.stdout+r.stderr);assert r.returncode==expected,(name,r.stderr);checks.append({'name':name,'command':command,'exit_code':r.returncode,'expected_exit_code':expected});print(name,r.returncode,r.stdout[-180:],r.stderr[-180:],flush=True);return r
build='g++ -std=c++17 -O2 -I/generated /experiment/project.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/motion_causal_project && g++ -std=c++17 -O2 -I/generated /experiment/prefix.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/prefix && cmake -S /experiment/motion-evaluation/pooled -B /outputs/pooled-build > /outputs/build.log 2>&1 && cmake --build /outputs/pooled-build -j2 >> /outputs/build.log 2>&1'
execute('tensorflow-absence','python /experiment/check_tensorflow.py');execute('build',build)
native=execute('native-regressions','/motion-build/motion_metrics_test --gtest_color=no && /motion-build/motion_metrics_utils_test --gtest_color=no');assert '[  PASSED  ] 19 tests.' in native.stdout and '[  PASSED  ] 23 tests.' in native.stdout
# Existing boundary fixture modules execute in the same pinned native runtime.
for name,count in [('native_cli',6),('joint_cli',2),('causal_projection',5),('pooled_cli',6)]:
 testcmd='PYTHONPATH=/experiment/tests python -m unittest test_motion_joint_cli.MotionJointCliTests -v' if name=='joint_cli' else 'python -m unittest discover -s /experiment/tests -p test_motion_'+name+'.py -v'
 test=execute(name,testcmd);assert 'Ran '+str(count)+' tests' in test.stderr and '\nOK\n' in test.stderr
for split,folder in [('training','motion-native-link-v5'),('validation','motion-validation-native-link-v1')]:
 execute(split+'-prefix','/outputs/motion_causal_project /source/'+split+'.pb /outputs/'+split+'-observations.pb && /outputs/prefix check /source/'+split+'.pb /outputs/'+split+'-observations.pb /outputs/'+split+'-future-injection.pb');assert sha(out/(split+'-observations.pb'))==sha(C/'insula'/folder/'output/observations.pb')
 refused=execute(split+'-future-refusal','/outputs/motion_causal_project /outputs/'+split+'-future-injection.pb /outputs/forbidden-'+split+'.pb',1);assert 'sensor coverage must be history/current only' in refused.stderr and not (out/('forbidden-'+split+'.pb')).exists()
assert all(sha(p)==h for p,h in pins.items());record={'checks':checks,'runtime_lock':lock,'pins':pins,'parent_receipts':parents,'native_regressions_passed':42,'boundary_fixture_groups_passed':19,'real_prefixes_replayed_exact':2,'real_future_sensor_refusals':2,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for p in out.rglob('*') if p.is_file()},'scope':'fresh foundation replay: native Motion regressions, single/joint/pooled/causal boundary fixtures and two exact real-source causal prefixes; scientific cohort/models remain separate'};(P/'research/motion-pilot-foundation-replay-verified.json').write_text(json.dumps(record,indent=2));print('PASS current Motion foundation replay',flush=True)
