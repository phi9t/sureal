"""Bounded observer collection controls. Fake transport is not native proof."""
import copy
import hashlib
import json
import os
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

from audit_support import test_runtime_probe as literal_fixtures
from audit_support import runtime_probe


class Client:
    def __init__(self,records):self.input=records;self.records=[]
    def call(self,method,params):
        record=next(entry for entry in self.input if entry['method']==method and
                    entry['params'].get('cursor')==params.get('cursor'))
        self.records.append(copy.deepcopy(record));return record['response']


class CollectionTests(unittest.TestCase):
    def setUp(self):
        reference=literal_fixtures.StopProbeTests();reference.setUp()
        self.fixture=reference.fixture;self.running=reference.running
        self.limits={'max_pages':2,'max_items':10}

    def test_actual_fresh_turn_is_derived_from_complete_native_pages(self):
        fixture={key:value for key,value in self.fixture.items() if key!='turn_ids'}
        with patch('audit_support.probe_os.capture_kernel',return_value=self.running['kernel']):
            snapshot=runtime_probe.collect_snapshot(Client(self.running['records']),fixture,{}, {},self.limits)
        self.assertEqual(fixture['turn_ids'],['fixture-turn'])
        self.assertEqual(len(snapshot['records']),6)

    def test_unread_pages_bound_and_extra_fresh_turn_refuse(self):
        records=copy.deepcopy(self.running['records'])
        records[2]['response']['data'].append({'id':'another-turn','status':'inProgress'})
        fixture={key:value for key,value in self.fixture.items() if key!='turn_ids'}
        with patch('audit_support.probe_os.capture_kernel',return_value=self.running['kernel']):
            with self.assertRaises(ValueError):runtime_probe.collect_snapshot(Client(records),fixture,{}, {},self.limits)
        records=copy.deepcopy(self.running['records'])
        records[2]['response']['nextCursor']='unread';self.limits['max_pages']=1
        with self.assertRaises(ValueError):runtime_probe.collect_snapshot(Client(records),fixture,{}, {},self.limits)

    def test_failed_empty_tool_snapshot_preserves_all_six_read_records(self):
        records=copy.deepcopy(self.running['records']);records[3]['response']['data']=[]
        client=Client(records)
        with self.assertRaisesRegex(ValueError,'No actual executed native tool witness'):
            runtime_probe.collect_snapshot(client,self.fixture,{}, {},self.limits)
        self.assertEqual(client.records,records)
        self.assertEqual({entry['method'] for entry in client.records},runtime_probe.READ_METHODS)

    def test_kernel_failure_keeps_native_records_for_diagnosis(self):
        client=Client(self.running['records'])
        with patch('audit_support.probe_os.capture_kernel',side_effect=ValueError('actual coverage gap')):
            with self.assertRaisesRegex(ValueError,'coverage gap'):
                runtime_probe.collect_snapshot(client,self.fixture,{}, {},self.limits)
        self.assertEqual(client.records,self.running['records'])

    def test_channel_collection_captures_real_kernel_before_empty_item_join(self):
        from audit_support import channel_observer
        self.assertTrue(callable(getattr(channel_observer,'collect_initial_snapshot',None)),
                        'Initial raw-channel collector absent')
        records=copy.deepcopy(self.running['records']);records[3]['response']['data']=[]
        client=Client(records)
        with patch('audit_support.probe_os.capture_kernel',return_value=self.running['kernel']) as capture:
            result=channel_observer.collect_initial_snapshot(client,self.fixture,{}, {},self.limits)
        capture.assert_called_once()
        self.assertEqual(result['records'][3]['response']['data'],[])
        self.assertEqual(client.records,records)
        self.assertEqual(result['kernel'],self.running['kernel'])
        self.assertLessEqual(result['interval']['started_ns'],result['interval']['ended_ns'])

    def test_only_successfully_fsynced_snapshot_clears_client_records(self):
        client=Client(self.running['records'])
        with patch('audit_support.probe_os.capture_kernel',return_value=self.running['kernel']):
            snapshot=runtime_probe.collect_snapshot(client,self.fixture,{}, {},self.limits)
        with tempfile.TemporaryDirectory(prefix='a50-record-retention-') as tmp:
            root=Path(tmp)
            with patch.object(runtime_probe,'write_new',side_effect=OSError('disk full')):
                with self.assertRaises(OSError):runtime_probe.retain_snapshot(client,root,'snapshot.json',snapshot,33554432)
            self.assertEqual(client.records,self.running['records'])
            reference=runtime_probe.retain_snapshot(client,root,'snapshot.json',snapshot,33554432)
            self.assertEqual(client.records,[])
            self.assertEqual(json.loads(Path(reference['path']).read_text())['records'],self.running['records'])

    def test_empty_tool_report_is_unknown_and_reopens_all_six_actual_shaped_reads(self):
        from audit_support import probe_authority,raw_git,native_read
        records=copy.deepcopy(self.running['records']);records[3]['response']['data']=[]
        client=Client(records);client.transport={'component_fixture':True}
        client.initialize=lambda:{'userAgent':'unit-component'};client.close=lambda:None
        fixture={**self.fixture,'output':'/unit/tool-output','common_git':'/unit/common-git',
            'operator_source':{'source':'/unit/operator-source','candidate':'unit-operator'},
            'operator_materialization':{'path':'/unit/operator-materialization'},'native_command_provenance':{}}
        with tempfile.TemporaryDirectory(prefix='a50-empty-tool-report-') as tmp:
            root=Path(tmp);path=root/'authority.json';path.write_text('{"schema_version":1,"fixture_only":true}')
            reference={'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}
            admission={'resources':{'deadline_ms':120000,'request_timeout_ms':2000,'max_pages':2,
                'max_items':10,'max_output_bytes':33554432},'auditor':{'materialization':reference},
                'user_authority':reference,'fixture_provenance':reference,'runtime':{},
                'native_shell':{'executable':reference},'protected_thread_ids':[os.environ.get('CODEX_THREAD_ID'),
                    'unit-lead','unit-reviewer']}
            # Source/resource/transport setup is a component seam; no native
            # connection or admitted live gate is substituted by these mocks.
            with patch.object(probe_authority,'validate_sources',return_value={'source':'/unit/auditor','candidate':'unit-auditor'}),\
                 patch.object(probe_authority,'validate_resources',return_value={'component_fixture':True}),\
                 patch.object(probe_authority,'load_fixture',return_value=fixture),\
                 patch.object(probe_authority,'checked_schema_runtime',return_value={}),\
                 patch.object(native_read,'NativeReadClient',return_value=client),\
                 patch.object(raw_git,'verify_materialization',return_value={}):
                report,exit_code=runtime_probe.observe(admission,root/'run',reference)
            self.assertEqual(exit_code,3);self.assertEqual(report['status'],'unknown')
            self.assertFalse(report['stop_capability']);self.assertFalse(report['ownership_released'])
            self.assertFalse(report['cleanup_permitted']);self.assertFalse(report['task50_accepted'])
            self.assertFalse(report['managed_dispatch_accepted'])
            raw=Path(report['incomplete_native_observation']['path'])
            self.assertEqual(hashlib.sha256(raw.read_bytes()).hexdigest(),report['incomplete_native_observation']['sha256'])
            self.assertEqual(json.loads(raw.read_text())['records'],records)


if __name__=='__main__':unittest.main()
