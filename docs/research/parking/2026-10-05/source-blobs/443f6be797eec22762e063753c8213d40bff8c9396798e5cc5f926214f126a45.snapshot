from pathlib import Path
import hashlib,json,subprocess,sys,time
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.runtime_identity import verify_rootfs
from pipeline.insula_entry import launch_plan
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
cache=Path.home()/'.cache/waystone/waymo-perception';root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256'])
prior=json.loads((code/'research/native-range-grid-integration-verified.json').read_text());source=cache/'insula/m3-live-b';shape=cache/'insula/native-range-shapes-a/output'
assert sha(source/'reconstruction/report.json')==prior['input_hashes']['reconstruction_report'] and sha(shape/'shapes.json')==prior['input_hashes']['shape_inventory']
base=cache/'insula/point-grid-linkage-native-v2';base.mkdir();inputs=base/'input';inputs.mkdir();output=base/'output';output.mkdir();expected={'report_sha256':prior['input_hashes']['reconstruction_report'],'shapes_sha256':prior['input_hashes']['shape_inventory']};(inputs/'expected.json').write_text(json.dumps(expected,indent=2)+'\n')
command=launch_plan(root,code,source,output,['python','/tmp/linkage/point-grid-native-worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(Path('.scratch').resolve()),'/tmp/linkage','--ro-bind',str(shape),'/tmp/native-shapes','--ro-bind',str(inputs),'/tmp/expected']
started=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=300);log=output/'live.log';log.write_text(r.stdout+r.stderr);print(log.read_text());assert r.returncode==0
receipt={'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'input_hashes':expected,'candidate_hashes':{'pipeline/native_range_grid.py':sha(code/'pipeline/native_range_grid.py')},'script_hashes':{p:sha(Path('.scratch')/p) for p in ['point_grid_linkage.py','test_point_grid_linkage.py','point-grid-native-worker.py','run-point-grid-native.py']},'elapsed_seconds':time.monotonic()-started,'validation':json.loads((output/'check.json').read_text()),'artifacts':{'live.log':sha(log),'check.json':sha(output/'check.json')},'output':str(output),'scope':'new complete join checker/live fixture refusals and native engineering integration; actual full103 linkage unverified'}
(code/'research/point-grid-linkage-native-verified.json').write_text(json.dumps(receipt,indent=2)+'\n')
