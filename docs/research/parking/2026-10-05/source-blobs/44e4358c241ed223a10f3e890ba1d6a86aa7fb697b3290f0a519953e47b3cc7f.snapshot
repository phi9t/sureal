import pathlib,sys,json,subprocess,shutil,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from advanced.archive import sha
phase=sys.argv[1];C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula'/('balanced16-sustained-loss-'+phase);R.mkdir();out=R/'output';out.mkdir();src=R/'input';src.mkdir();code=R/'code';code.mkdir()
for directory in ['pipeline','gpu','tier1']:
 shutil.copytree(P/directory,code/directory,ignore=shutil.ignore_patterns('__pycache__','*.pyc'))
(code/'cohort').mkdir()
for name in ['sustained_loss.py','test_sustained_loss.py']:
 if (P/'cohort'/name).exists():shutil.copyfile(P/'cohort'/name,code/'cohort'/name)
pins={str(p):sha(p) for p in code.rglob('*.py')};root=C/'gpu-rootfs';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);command=launch_plan(root,code,src,out,['/opt/waymo/bin/python','-m','unittest','discover','-s','/experiment/cohort','-p','test_sustained_loss.py','-v']);start=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(r.stdout+r.stderr);print(r.stdout,r.stderr);expected=1 if phase=='red' else 0;assert r.returncode==expected
if phase=='red':assert "No module named 'cohort.sustained_loss'" in r.stderr
else:assert 'Ran 3 tests' in r.stderr and '\nOK\n' in r.stderr
assert all(sha(p)==h for p,h in pins.items());record={'command':command,'exit_code':r.returncode,'expected_exit_code':expected,'runtime_lock':lock,'pins':pins,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for p in out.iterdir()},'scope':'CPU Torch loss-equation fixtures without GPU device binding; no training or cohort admission'};(P/'research'/('balanced16-sustained-loss-'+phase+'-verified.json')).write_text(json.dumps(record,indent=2))
