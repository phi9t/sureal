import hashlib,json,re,subprocess,sys,time
from pathlib import Path
exp=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(exp))
from pipeline.runtime_identity import verify_rootfs
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
prior=json.loads((exp/'research/camera-native-projection-executed.json').read_text())
base=Path.home()/'.cache/waystone/waymo-perception/insula/camera-native-bridge-a'
run=base.parent/'camera-convention-diagnostic-a';run.mkdir(exist_ok=False);(run/'input').mkdir();(run/'output').mkdir();(run/'audit').mkdir()
old=base/'input';image=(old/'image.txt').read_text();cal=(old/'calibration.txt').read_text()
r=[float(x) for x in re.findall(r'transform: ([^ }]+)',image)];assert len(r)==16
w=[float(re.search(r'\bw_'+k+r': ([^ }]+)',image)[1]) for k in 'xyz']
body=[sum(r[4*i+j]*w[i] for i in range(3)) for j in range(3)]
variant=image
for k,value in zip('xyz',body):variant=re.sub(r'\bw_'+k+r': [^ }]+','w_'+k+': '+repr(value),variant)
variants={'native':(cal,image),'global_shutter':(cal.replace('rolling_shutter_direction: 2','rolling_shutter_direction: 5'),image),'angular_global_to_body':(cal,variant)}
for name,(c,i) in variants.items():
 (run/'input'/f'{name}-calibration.txt').write_text(c);(run/'input'/f'{name}-image.txt').write_text(i)
cmd0=prior['checks'][0]['command'];verify_rootfs(Path(cmd0[4]),prior['runtime_lock']['rootfs_sha256'])
assert sha(Path(cmd0[cmd0.index('/tmp/camera-binary')-1])/'project_camera')==prior['binary_sha256']
assert sha(base/'receipt.json')==prior['receipt_sha256']
checks=[]
for name in variants:
 cmd=cmd0[:cmd0.index('--')];cmd[cmd.index(str(base/'output'))]=str(run/'output')
 cmd+=['--ro-bind',str(run/'input'),'/tmp/variants','--','/tmp/camera-binary/project_camera',f'/tmp/variants/{name}-calibration.txt',f'/tmp/variants/{name}-image.txt','/tmp/native-input/world.xyz',f'/outputs/{name}.csv']
 start=time.monotonic();result=subprocess.run(cmd,capture_output=True,text=True);(run/f'{name}.log').write_text(result.stdout+result.stderr);assert result.returncode==0,result.stderr
 checks.append({'command':cmd,'exit_code':result.returncode,'elapsed_seconds':time.monotonic()-start})
audit=json.loads((exp/'research/camera-native-projection-residuals.json').read_text())['checks'][0]['command'];audit=audit[:audit.index('--')];audit[audit.index(str(base/'audit'))]=str(run/'audit');audit[audit.index(str(base/'output'))]=str(run/'output')
script="""import json,numpy as np
from pathlib import Path
with np.load('/tmp/native-input/native.npz',allow_pickle=False) as a:cp=a['camera_projection']
n=len(cp);slots=cp.reshape(n,2,3);result={}
for name in ['native','global_shutter','angular_global_to_body']:
 p=np.loadtxt('/tmp/projected/'+name+'.csv',delimiter=',');assert p.shape==(n,5);np.testing.assert_array_equal(p[:,0],np.arange(n));assert np.isfinite(p).all()
 errors=[];invalid=0
 for s in range(2):
  c,u,v=slots[:,s,:].T;mask=(c==1)&(u>=0)&(u<1920)&(v>=0)&(v<1280);invalid+=int((mask&(p[:,1]==0)).sum());mask&=p[:,1]==1;errors.extend((p[mask,2:4]-slots[mask,s,1:3]).tolist())
 d=np.asarray(errors);q=np.linalg.norm(d,axis=1);result[name]={'compared':len(d),'invalid':invalid,'l2_quantiles':dict(zip(['p50','p90','p95','p99','max'],map(float,np.quantile(q,[.5,.9,.95,.99,1])))),'mean_delta_uv':d.mean(0).tolist(),'within_one_pixel_each_axis':int((abs(d)<=1).all(1).sum())}
Path('/outputs/results.json').write_text(json.dumps(result,indent=2));print(json.dumps(result))
"""
audit+=['--','python','-c',script];ret=subprocess.run(audit,capture_output=True,text=True);(run/'audit/live.log').write_text(ret.stdout+ret.stderr);assert ret.returncode==0,ret.stderr
checks.append({'command':audit,'exit_code':ret.returncode})
evidence={'scope':'one native frame; one-variable convention diagnostics only, no production transform change or visibility promotion','checks':checks,'runtime_lock':prior['runtime_lock'],'binary_sha256':prior['binary_sha256'],'original_projection_receipt_sha256':prior['receipt_sha256'],'angular_native':w,'angular_global_to_body':body,'script_sha256':sha(__file__),'validation':json.loads((run/'audit/results.json').read_text()),'artifacts':{str(p.relative_to(run)):sha(p) for p in sorted(run.rglob('*')) if p.is_file()}}
(run/'receipt.json').write_text(json.dumps(evidence,indent=2));evidence['receipt']=str(run/'receipt.json');evidence['receipt_sha256']=sha(run/'receipt.json');(exp/'research/camera-convention-diagnostic-verified.json').write_text(json.dumps(evidence,indent=2));print(ret.stdout)
