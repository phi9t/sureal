import pathlib,json,sys,subprocess,hashlib,shutil,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from tier1.storage import unique_payload_bytes
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-geometry-producer-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_geometry_producer.py',code/'producer.py');shutil.copy(P/'motion-evaluation/ingestion/delta_components.py',code/'delta_components.py');(code/'pipeline').mkdir()
for name in ['geometry.py','geometry_foundation.py']:shutil.copy(P/'pipeline'/name,code/'pipeline'/name)
for split in ['training','validation']:shutil.copy(C/'insula/motion-geometry-metadata-v1'/split/'metadata.json',code/(split+'-metadata.json'))
W=C/'scientific-processing';assert unique_payload_bytes(W)+256*1024**2<15*1024**3;out=W/'motion-current-geometry-v1';out.mkdir();root=C/'insula/rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for p in code.rglob('*') if p.is_file()};cmd=launch_plan(root,code,W/'motion-delta-components-v1',out,['python','/experiment/producer.py']);start=time.monotonic();r=subprocess.run(cmd,capture_output=True,text=True,timeout=300);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;assert all(sha(p)==h for p,h in pins.items());assert unique_payload_bytes(out)<256*1024**2 and unique_payload_bytes(W)<15*1024**3;receipt={'command':cmd,'exit_code':0,'runtime_lock':lock,'source_pins':pins,'validation':json.loads((out/'check.json').read_text()),'elapsed_seconds':time.monotonic()-start,'artifacts':{str(p):sha(p) for p in out.rglob('*') if p.is_file()},'scope':'native XYZ producer only; separate scalar source geometry/ray/features audit required'};(P/'research/motion-current-geometry-producer-verified.json').write_text(json.dumps(receipt,indent=2));print(r.stdout)
