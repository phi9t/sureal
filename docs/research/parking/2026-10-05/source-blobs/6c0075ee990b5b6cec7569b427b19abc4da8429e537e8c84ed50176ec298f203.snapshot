from pathlib import Path
import subprocess,time
code=Path('experiments/waymo-perception');logs=Path.home()/'.cache/waystone/waymo-perception/insula/continuation-logs'
while not (code/'research/architecture-retain64-execution-verified.json').exists():time.sleep(2)
for worker in ['run-retain64-loss-audit.py','score-retain64-score-first.py','audit-retain64-score-first.py']:
 with (logs/('architecture-retain64-'+worker+'.log')).open('w') as f:r=subprocess.run(['python','.scratch/'+worker,'retain64'],stdout=f,stderr=subprocess.STDOUT)
 assert r.returncode==0,worker
 print('ADMITTED retain64',worker,flush=True)
