import pathlib,json,sys,shutil,subprocess,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from advanced.archive import sha
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/balanced16-sustained-candidate-v1';R.mkdir();code=R/'code';(code/'cohort').mkdir(parents=True);source=R/'inputs';source.mkdir();out=R/'output';out.mkdir();shutil.copyfile(P/'cohort/sustained_contract.py',code/'cohort/sustained_contract.py');shutil.copyfile(P/'research/balanced16-sustained.candidate.json',source/'candidate.json');original=C/'insula/cohort16-baseline-balanced20261002a/run.json';shutil.copyfile(original,source/'original.json');pins={str(p):sha(p) for root in [code,source] for p in root.rglob('*') if p.is_file()};pins[str(original)]=sha(original)
program="""import json
from pathlib import Path
from cohort.sustained_contract import validate_contract
candidate=json.loads(Path('/source/candidate.json').read_text());original=json.loads(Path('/source/original.json').read_text());frames=[{k:f[k] for k in ['identity','split','sha256']} for f in original['manifest']['frames']];validate_contract(candidate,frames);report={'original_training_frames_exact':len(frames),'recipes':candidate['recipes'],'max_updates':candidate['max_updates'],'max_training_seconds':candidate['max_training_seconds'],'decoder_version':candidate['decoder_version'],'scope':'candidate identity/execution contract only; no training or scientific admission'};Path('/outputs/check.json').write_text(json.dumps(report,indent=2));print('PASS exact16 training frames and four matched recipes')"""
root=C/'insula/rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);command=launch_plan(root,code,source,out,['python','-c',program]);start=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(r.stdout+r.stderr);print(r.stdout,r.stderr);assert r.returncode==0 and all(sha(p)==h for p,h in pins.items());record={'command':command,'exit_code':0,'runtime_lock':lock,'pins':pins,'validation':json.loads((out/'check.json').read_text()),'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for p in out.iterdir()}};(P/'research/balanced16-sustained-candidate-live-verified.json').write_text(json.dumps(record,indent=2))
