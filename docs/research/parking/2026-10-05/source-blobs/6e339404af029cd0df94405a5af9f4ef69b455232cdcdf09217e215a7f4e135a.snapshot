from pathlib import Path
import json,hashlib,sys,subprocess
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
r=code/'research';protocol=r/'pointpillars-scientific-protocol.candidate.json';d=json.loads(protocol.read_text());progress=json.loads((r/'scientific-native-shape-progress.json').read_text());cache=Path.home()/'.cache/waystone/waymo-perception';source=cache/'scientific-processing/native-shape-sources-v1';entries=[];frames=[]
for scene in d['cohorts']['train']:
 v=progress['scene_evidence'][scene];ep=r/v['evidence'];assert sha(ep)==v['evidence_sha256'];e=json.loads(ep.read_text());assert e['membership']=={'official_split':'training','research_splits':['train']};p=source/scene;receipt=p/'receipt.json';assert sha(receipt)==e['receipt_sha256']==v['receipt_sha256'];rc=json.loads(receipt.read_text());report=p/'worker/shapes.json';assert sha(report)==rc['report_sha256']==rc['artifacts']['worker/shapes.json'];s=json.loads(report.read_text());assert s['shapes']['scene']==scene
 timestamps=sorted({x['timestamp'] for x in s['shapes']['records']})
 for timestamp in timestamps:
  key=f'{scene}:{timestamp}';frames.append({'scene':scene,'timestamp_micros':timestamp,'selection_hash':hashlib.sha256(('overfit-v1:'+key).encode()).hexdigest()})
 entries.append({'scene':scene,'evidence':v['evidence'],'evidence_sha256':sha(ep),'receipt_sha256':sha(receipt),'report_sha256':sha(report),'records':len(s['shapes']['records']),'frames':len(timestamps)})
selected=sorted(frames,key=lambda x:(x['selection_hash'],x['scene'],x['timestamp_micros']))[:16]
candidate={'status':'training-only16-frame identity selection; payload joins and overfit still required','protocol_sha256':sha(protocol),'selection':'ascending SHA256(overfit-v1:segment:timestamp); first16 unique training frame keys; lexical identity tie break','eligible_training_frames':len(frames),'sources':entries,'frames':selected,'scope':'native LiDAR key metadata only; no box-label or model outcome selection; native observation/target joins not yet loaded'}
cp=r/'pointpillars-overfit-frames.candidate.json';assert not cp.exists();cp.write_text(json.dumps(candidate,indent=2)+'\n')
root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);base=cache/'insula/pointpillars-overfit-selection-v1';base.mkdir();inputs=base/'input';inputs.mkdir();out=base/'output';out.mkdir();(inputs/'expected.json').write_text(json.dumps({'candidate_sha256':sha(cp),'protocol_sha256':sha(protocol)}))
program='''import json,hashlib,copy
from pathlib import Path
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
e=json.loads(Path('/tmp/input/expected.json').read_text());r=Path('/experiment/research');assert sha(r/'pointpillars-scientific-protocol.candidate.json')==e['protocol_sha256'];assert sha(r/'pointpillars-overfit-frames.candidate.json')==e['candidate_sha256'];d=json.loads((r/'pointpillars-scientific-protocol.candidate.json').read_text());c=json.loads((r/'pointpillars-overfit-frames.candidate.json').read_text())
assert c['protocol_sha256']==e['protocol_sha256'] and len(c['sources'])==64 and {x['scene'] for x in c['sources']}==set(d['cohorts']['train'])
keys=set();counts=0
for src in c['sources']:
 scene=src['scene'];ep=r/src['evidence'];assert sha(ep)==src['evidence_sha256'];admission=json.loads(ep.read_text());assert admission['membership']=={'official_split':'training','research_splits':['train']};assert admission['checks'] and all(x['exit_code']==0 for x in admission['checks'])
 p=Path('/source')/scene;assert sha(p/'receipt.json')==src['receipt_sha256']==admission['receipt_sha256'];receipt=json.loads((p/'receipt.json').read_text());assert receipt['checks'] and all(x['exit_code']==0 for x in receipt['checks']);assert sha(p/'worker/shapes.json')==src['report_sha256']==receipt['report_sha256']==receipt['artifacts']['worker/shapes.json']
 report=json.loads((p/'worker/shapes.json').read_text());rows=report['shapes']['records'];assert report['shapes']['scene']==scene and len(rows)==src['records'];identities=set();timestamps=set()
 for row in rows:
  assert row['context']==scene and type(row['timestamp']) is int and row['timestamp']>0 and row['laser'] in range(1,6) and row['return'] in (1,2)
  identity=(row['timestamp'],row['laser'],row['return']);assert identity not in identities;identities.add(identity);timestamps.add(row['timestamp'])
 assert len(timestamps)==src['frames'] and len(identities)==10*len(timestamps)
 for timestamp in timestamps:keys.add((scene,timestamp))
 counts+=len(rows)
assert len(keys)==c['eligible_training_frames']
ordered=sorted(keys,key=lambda x:(hashlib.sha256(f'overfit-v1:{x[0]}:{x[1]}'.encode()).hexdigest(),*x))[:16]
expected=[{'scene':scene,'timestamp_micros':t,'selection_hash':hashlib.sha256(f'overfit-v1:{scene}:{t}'.encode()).hexdigest()} for scene,t in ordered]
def check(frames):
 assert frames==expected and len({(x['scene'],x['timestamp_micros']) for x in frames})==16
 assert all(x['scene'] in d['cohorts']['train'] for x in frames)
check(c['frames']);mutants=[]
m=copy.deepcopy(c['frames']);m[0]['scene']=d['cohorts']['validation'][0];mutants.append(m)
m=copy.deepcopy(c['frames']);m[1]=copy.deepcopy(m[0]);mutants.append(m)
m=copy.deepcopy(c['frames']);m[0]['timestamp_micros']+=1;mutants.append(m)
m=copy.deepcopy(c['frames']);m[0],m[1]=m[1],m[0];mutants.append(m)
for m in mutants:
 try:check(m)
 except AssertionError:pass
 else:raise AssertionError('invalid selection admitted')
Path('/outputs/check.json').write_text(json.dumps({'training_scenes':64,'eligible_training_frames':len(keys),'native_return_records':counts,'selected_frames':expected,'refused_mutants':4,'scope':'native metadata selection independently reconciled; no sensor payload/box joins or overfit outcome established'},indent=2));print('PASS exact16 training frame identities independently selected from',len(keys),'native frame keys')
'''
command=launch_plan(root,code,source,out,['python','-c',program]);i=command.index('--');command[i:i]=['--ro-bind',str(inputs),'/tmp/input'];run=subprocess.run(command,capture_output=True,text=True,timeout=60);log=out/'live.log';log.write_text(run.stdout+run.stderr);print(log.read_text());assert run.returncode==0
record={'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'candidate_sha256':sha(cp),'protocol_sha256':sha(protocol),'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in [out/'check.json',log]}}
(r/'pointpillars-overfit-selection-verified.json').write_text(json.dumps(record,indent=2)+'\n')
