from pathlib import Path
import hashlib,json,subprocess,sys
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.runtime_identity import verify_rootfs
from pipeline.insula_entry import launch_plan
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
cache=Path.home()/'.cache/waystone/waymo-perception';root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);base=cache/'insula/one-batch-sign-geometry-v1';base.mkdir();out=base/'output';out.mkdir();worker=Path('.scratch/one-batch-sign-geometry-diagnostics.py').resolve();digest=sha(worker)
report=cache/'scientific-processing/overfit-native-cache-v1/7912728502266478772_1202_200_1222_200/1506905332721474/producer/report.json';source=cache/'scientific-processing/native-one-batch-overfit-prepared-v3';pins={str(p):sha(p) for p in [report,source/'predictions.json',source/'groundtruth.json']}
command=launch_plan(root,code,source,out,['python','/tmp/worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(worker),'/tmp/worker.py','--ro-bind',str(report),'/tmp/native-report.json'];run=subprocess.run(command,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(run.stdout+run.stderr);print(run.stdout+run.stderr);assert run.returncode==0 and sha(worker)==digest and all(sha(p)==h for p,h in pins.items())
record={'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'worker_sha256':digest,'input_hashes':pins,'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in out.iterdir()},'scope':'live observational geometry diagnostics; not an independently audited quality acceptance'};(code/'research/one-batch-sign-geometry-diagnostics.json').write_text(json.dumps(record,indent=2)+'\n')
