from pathlib import Path
import hashlib,json,sys,subprocess,base64
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
workers=Path('.scratch').resolve();cache=Path.home()/'.cache/waystone/waymo-perception';root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);base=cache/'insula/overfit-box-worker-fixture-v1';base.mkdir();fixture=base/'fixture';fixture.mkdir();inputs=base/'input';inputs.mkdir();checks=[]
def run(source,out,program,extra=()):
 command=launch_plan(root,code,source,out,program);i=command.index('--');command[i:i]=['--ro-bind',str(workers),'/tmp/workers',*extra];p=subprocess.run(command,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(p.stdout+p.stderr);print(p.stdout+p.stderr);assert p.returncode==0;checks.append({'command':command,'exit_code':0})
run(workers,fixture,['python','-c',"import sys;sys.path.insert(0,'/tmp/workers');from test_overfit_box_targets import row;import pyarrow as pa,pyarrow.parquet as pq;rs=[row(),row(1,'unknown',0),row(2,'other')];rs[2]['[LiDARBoxComponent].difficulty_level.detection']=2;pq.write_table(pa.Table.from_pylist(rs),'/outputs/source.parquet')"])
p=fixture/'source.parquet';source={'source_metadata':{'size':p.stat().st_size,'md5_hash':base64.b64encode(hashlib.md5(p.read_bytes()).digest()).decode()},'sha256':sha(p),'hdfs_roundtrip_sha256':sha(p),'inventory':{'rows':3}}
(inputs/'job.json').write_text(json.dumps({'scene':'scene','timestamps':[1,3],'source':source}));producer=base/'producer';producer.mkdir();reference=base/'reference';reference.mkdir();extra=['--ro-bind',str(inputs),'/tmp/input']
run(fixture,producer,['python','/tmp/workers/overfit-box-worker.py','producer'],extra)
run(fixture,reference,['python','/tmp/workers/overfit-box-worker.py','reference'],[*extra,'--ro-bind',str(producer),'/tmp/produced'])
assert sha(producer/'targets.json')==sha(reference/'targets.json');result=json.loads((producer/'targets.json').read_text());assert result['frames'][1]['annotation_state']=='no_native_box_rows_coverage_unresolved' and len(result['frames'][0]['rows'])==2 and result['frames'][0]['rows'][1]['type']==0
record={'checks':checks,'runtime_lock':lock,'worker_hashes':{p.name:sha(p) for p in [workers/'overfit_box_targets.py',workers/'overfit-box-worker.py',workers/'test_overfit_box_targets.py']},'validation':{'native_rows':3,'selected_frames':2,'unknown_class_retained':True,'missing_coverage_not_invented':True},'artifacts':{str(p):sha(p) for p in base.rglob('*') if p.is_file()},'scope':'Parquet byte/producer/literal reference fixture only; real native source extraction remains open'}
(code/'research/overfit-box-worker-fixture-verified.json').write_text(json.dumps(record,indent=2)+'\n');print('PASS independent streamed Parquet target fixture')
