"""Root-owned literal live guards; independently authored observer does not import.

These helpers preserve actual source equality and readiness identities. They
neither reconstruct static Git authority nor grant native stop acceptance.
"""
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import stat
import time


def digest(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def reopen(ref):
    path = Path(ref['path'])
    if (not path.is_absolute() or path.resolve() != path or
        not stat.S_ISREG(path.lstat().st_mode) or digest(path) != ref['sha256']):
        raise ValueError('literal exact artifact required')
    return path


def incarnation(pid):
    text = Path(f'/proc/{pid}/stat').read_text()
    values = text[text.rindex(')')+2:].split()
    return {'boot_id': Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
            'pid': pid, 'start_ticks': int(values[19]), 'parent_pid': int(values[1]),
            'uid': Path(f'/proc/{pid}').stat().st_uid}


def argv(pid):
    return [os.fsdecode(value) for value in Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0') if value]


def process_scope(pid):
    paths = [row[3:] for row in Path(f'/proc/{pid}/cgroup').read_text().splitlines() if row.startswith('0::')]
    if len(paths) != 1:
        raise ValueError('one actual unified scope required')
    root = Path('/sys/fs/cgroup'+paths[0])
    info = root.stat()
    return {'path': str(root), 'device': info.st_dev, 'inode': info.st_ino,
            'memory_max': (root/'memory.max').read_text().strip(),
            'memory_swap_max': (root/'memory.swap.max').read_text().strip()}


def full_manifest(context):
    started = time.monotonic_ns()
    root = Path(context['source'])
    if not root.is_absolute() or root.resolve() != root or not root.is_dir():
        raise ValueError('literal reconstructed source root required')
    expected, directories, entries = set(), set(), []
    for entry in context['entries']:
        rel = PurePosixPath(entry['path'])
        if rel.is_absolute() or '..' in rel.parts or rel.as_posix() != entry['path']:
            raise ValueError('unsafe raw source entry')
        path = root/entry['path']
        if entry['kind'] == 'commit':
            if (entry['mode'] != '160000' or not entry.get('excluded') or
                entry['path'] not in context['gitlinks_excluded'] or os.path.lexists(path)):
                raise ValueError('excluded Gitlink changed')
            entries.append(entry)
            continue
        if entry['kind'] != 'blob' or entry['path'] in expected:
            raise ValueError('duplicate or unknown source entry')
        expected.add(entry['path'])
        directories.update(str(parent) for parent in rel.parents if str(parent) != '.')
        info = path.lstat()
        if entry['mode'] == '120000':
            if not stat.S_ISLNK(info.st_mode):
                raise ValueError('source link type changed')
            data = os.fsencode(os.readlink(path))
        elif entry['mode'] in {'100644', '100755'}:
            if (not stat.S_ISREG(info.st_mode) or
                stat.S_IMODE(info.st_mode) != (0o755 if entry['mode'] == '100755' else 0o644)):
                raise ValueError('source file type/mode changed')
            data = path.read_bytes()
        else:
            raise ValueError('unadmitted source mode')
        if (len(data) != entry['bytes'] or hashlib.sha256(data).hexdigest() != entry['sha256'] or
            hashlib.sha1(b'blob '+str(len(data)).encode()+b'\0'+data).hexdigest() != entry['oid']):
            raise ValueError('actual source bytes changed')
        entries.append(entry)
    actual_files, actual_dirs = set(), set()
    for directory, dirs, files in os.walk(root, followlinks=False):
        for name in dirs+files:
            path = Path(directory)/name
            rel = path.relative_to(root).as_posix()
            info = path.lstat()
            if stat.S_ISDIR(info.st_mode):
                actual_dirs.add(rel)
            elif stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                actual_files.add(rel)
            else:
                raise ValueError('unsupported source entry')
    if actual_files != expected or actual_dirs != directories:
        raise ValueError('source entry union changed')
    return {'kind': 'FreshSourceManifest', 'source': str(root), 'entries': entries,
            'gitlinks_excluded': context['gitlinks_excluded'],
            'started_ns': started, 'ended_ns': time.monotonic_ns()}


def channel_layout(pin, forbidden):
    root = Path(pin['path'])
    info = root.lstat()
    if (not root.is_absolute() or root.resolve() != root or not stat.S_ISDIR(info.st_mode) or
        any(pin[key] != value for key, value in [('uid', info.st_uid), ('device', info.st_dev), ('inode', info.st_ino)]) or
        info.st_uid != os.getuid()):
        raise ValueError('channel directory incarnation changed')
    for name in forbidden:
        other = Path(name)
        if not other.is_absolute() or other.resolve() != other:
            raise ValueError('literal forbidden root required')
        if root.is_relative_to(other) or other.is_relative_to(root):
            raise ValueError('channel overlaps admitted source/writer roots')


def check_ready(ready, expected, now):
    if (ready.get('kind') != 'ObserverReady' or type(ready.get('ready_ns')) is not int or
        not 0 <= now-ready['ready_ns'] <= 2000000000 or any(
        ready.get(key) != expected[key] for key in ('fixture_id', 'static_preflight', 'output', 'source'))):
        raise ValueError('ready authority/identity/freshness differs')
    process = ready['process']
    actual = incarnation(process['pid'])
    if any(actual[key] != process[key] for key in ('boot_id', 'pid', 'start_ticks', 'uid')):
        raise ValueError('observer birth changed')
    if argv(process['pid']) != ready['argv']:
        raise ValueError('observer argv changed')
    own = process_scope(process['pid'])
    pin = ready['observer_scope']
    if any(own[key] != pin[key] for key in ('path', 'device', 'inode')):
        raise ValueError('observer scope identity changed')
    if own['memory_max'] != '268435456' or own['memory_swap_max'] != '0':
        raise ValueError('observer capped scope required')
    members = [int(row) for row in (Path(own['path'])/'cgroup.procs').read_text().splitlines()]
    if members != [process['pid']]:
        raise ValueError('observer scope is not exclusive')
    return actual


def fresh_sources(admission):
    """Reopen exact static authority, current raw packs and entire source trees."""
    static = admission['static_preflight']
    report = json.loads(reopen(static['report']).read_text())
    command = json.loads(reopen(static['command']).read_text())
    if (report.get('kind') != 'IndependentStaticPreflight' or report.get('status') != 'pass' or
        command.get('exit_code') != 0 or type(command.get('started_ms')) is not int or
        type(command.get('ended_ms')) is not int or
        not 0 <= command['ended_ms']-command['started_ms'] <= 120000):
        raise ValueError('completed bounded static command/report required')
    for name in ('stdout', 'stderr'):
        reopen(command[name])
    authority = json.loads(reopen(report['authorization']).read_text())
    if authority.get('kind') != 'StaticRuntimeProbeAdmission' or any(
        authority.get(key) != admission[key] for key in
        ('auditor', 'operator', 'runtime', 'notification_schemas', 'fixture_plan', 'user_authority')):
        raise ValueError('static source/runtime/layout/authority differs')
    results = []
    for role in ('auditor', 'operator'):
        pin = admission[role]
        context = json.loads(reopen(pin['materialization']).read_text())
        retention = json.loads(reopen(pin['retention']).read_text())
        review = json.loads(reopen(pin['review']).read_text())
        if (context != report[role+'_context'] or context['candidate'] != pin['candidate'] or
            retention['candidate'] != pin['candidate'] or retention['tree'] != context['tree'] or
            review.get('candidate') != pin['candidate'] or review.get('source') != context['source'] or
            review.get('verdict') != 'pass' or not review.get('reviewer_native_thread_id') or
            review['reviewer_native_thread_id'] == admission['author_native_thread_id']):
            raise ValueError('raw context/review binding differs')
        reopen({'path': retention['pack_path'], 'sha256': retention['pack_sha256']})
        results.append(full_manifest(context))
    for ref in admission['notification_schemas'].values():
        reopen(ref)
    for ref in admission['fixture_plan']['tools'].values():
        reopen(ref)
    reopen(admission['user_authority'])
    return results
