import json,pathlib,hashlib,datetime
w=pathlib.Path.home()/'.cache/waystone/waymo-perception/scientific-processing';old='8331804655557290264_4351_740_4371_740';s='2094681306939952000_2972_300_2992_300';b=w/'cohort-v1'/s;h=pathlib.Path('experiments/waymo-perception');sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();cp=json.loads((w/'cohort-v1'/old/'receipt.json').read_text());m=h/'scientific-acquisition.candidate.json';manifest=json.loads(m.read_text());cp['scene']=s;cp['membership']=manifest['scenes'][s];cp['manifest_sha256']=sha(m);cp['source_record_hashes']={c:sha(w.parent/'scientific-source-audit'/f"{cp['membership']['official_split']}-{c}-{s}.json") for c in manifest['components']};paths=list((b/'points/evidence').glob('*/receipt.json'))+list((b/'camera/evidence').glob('*/receipt.json'))+[b/n/'receipt.json' for n in ['point-publication','point-replay','sidecar-publication','camera-publication','camera-replay']]+[b/'points/point-eviction.json',b/'points/sidecar-eviction.json',b/'camera/camera-eviction.json',b/'camera-evidence.json']+list(b.glob('*.log'))+[w/'interrupted-sidecar-publication-third.log'];cp['retained_evidence_hashes']={str(p):sha(p) for p in paths};pr=json.loads((b/'point-replay/receipt.json').read_text());cr=json.loads((b/'camera-replay/receipt.json').read_text());cp['point_validation']=pr['validation'];cp['camera_validation']=cr['validation'];cp['point_hdfs_uri']=json.loads((b/'point-publication/receipt.json').read_text())['archive_hdfs_uri'];cp['camera_hdfs_uri']=json.loads((b/'camera-publication/receipt.json').read_text())['archive_hdfs_uri'];records=[h/'research'/n for n in ['interrupted-sidecar-publication-third-execution.json','interrupted-sidecar-eviction-third-verified.json','interrupted-camera-lifecycle-third-executed.json']];cp['recovery_provenance']={str(p):sha(p) for p in records};cp['checks']=json.loads(records[2].read_text())['checks']+json.loads(records[1].read_text())['checks'];cp['status']='recovered native scene lifecycle; independent admission pending';cp['ended_utc']=datetime.datetime.now(datetime.timezone.utc).isoformat();out=b/'receipt.json';assert not out.exists();out.write_text(json.dumps(cp,indent=2)+'\n');print('checkpoint retained',len(paths),'worker receipts',sum(p.name=='receipt.json' for p in paths))
