from pathlib import Path
import sys,json,subprocess,hashlib
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
cache=Path.home()/'.cache/waystone/waymo-perception';root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);out=cache/'insula/architecture-storage-audit-v1';out.mkdir();worker=Path('.scratch/architecture-storage-audit.py').resolve();sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();digest=sha(worker);command=launch_plan(root,code,cache/'scientific-processing',out,['python','/tmp/worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(worker),'/tmp/worker.py'];run=subprocess.run(command,capture_output=True,text=True,timeout=120);(out/'live.log').write_text(run.stdout+run.stderr);print(run.stdout+run.stderr);assert run.returncode==0 and sha(worker)==digest;(code/'research/architecture-storage-audit-verified.json').write_text(json.dumps({'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'worker_sha256':digest,'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in out.iterdir()}},indent=2)+'\n')
