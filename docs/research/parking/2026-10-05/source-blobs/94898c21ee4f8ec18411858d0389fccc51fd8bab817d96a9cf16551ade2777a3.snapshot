import json,hashlib
from pathlib import Path
import numpy as np
from itertools import zip_longest
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
e=json.loads(Path('/tmp/expected.json').read_text());original=e['original'];repeat=e['repeat']
for receipt,root in [(original,Path('/source')),(repeat,Path('/tmp/repeat'))]:
 for p,h in receipt['artifacts'].items():assert sha(root/Path(p).relative_to(e['original_root'] if receipt is original else e['repeat_root']))==h
for step in [0,25,50,100,200,300,500,750,1000,1500,2000]:
 name=f'checkpoint-{step:04d}/heads-00.npz'
 with np.load(Path('/source')/name,allow_pickle=False) as a,np.load(Path('/tmp/repeat')/name,allow_pickle=False) as b:
  assert set(a.files)==set(b.files)
  for k in a.files:np.testing.assert_array_equal(a[k],b[k])
for x,y in zip_longest(original['validation']['step_records'],repeat['validation']['step_records']):assert x==y
for key in ['initial_eval_losses','final_eval_losses','component_curve','gradient_curve','parameters','updates']:assert original['validation'][key]==repeat['validation'][key],key
Path('/outputs/check.json').write_text(json.dumps({'all11checkpoint_heads_exactly_equal':True,'all2000_step_losses_and_gradnorms_exactly_equal':True,'components_and_gradient_curve_exactly_equal':True,'scope':'exclusive repeat corroborates original quality/loss trajectory; exclusively measured step wall supersedes contaminated original timing'}));print('PASS exact trajectory equality; exclusive timing admitted')
