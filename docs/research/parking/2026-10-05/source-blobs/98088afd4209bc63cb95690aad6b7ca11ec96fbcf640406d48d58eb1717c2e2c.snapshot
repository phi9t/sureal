from pathlib import Path
import hashlib,json,subprocess,sys
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.runtime_identity import verify_rootfs
from pipeline.insula_entry import launch_plan
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
variant=sys.argv[1];assert variant in ['gn_backbone','gn_backbone_ln_pillar','no_norm']
cache=Path.home()/'.cache/waystone/waymo-perception';evidence=code/('research/norm-'+variant+'-score-first-verified.json');receipt=json.loads(evidence.read_text());manifest=json.loads((cache/('insula/norm-'+variant+'-score-first-v1/input/manifest.json')).read_text());assert sha(cache/('insula/norm-'+variant+'-score-first-v1/input/manifest.json'))==receipt['manifest_sha256']
base=cache/('insula/norm-'+variant+'-score-first-audits-v1');base.mkdir();checks=[];artifacts={};validation=[];locks={};worker_pins={}
for stage,root in [('geometry',cache/'insula/rootfs-v2'),('metrics',cache/'metrics-rootfs')]:
 lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);locks[stage]=lock
for row in receipt['validation']['curve']:
 step=row['step'];original=cache/('scientific-processing/norm-'+variant+'-score-first-v1')/str(step);sub={p:h for p,h in receipt['artifacts'].items() if Path(p).is_relative_to(original)};v=json.loads((original/'scored/check.json').read_text());assert row['LEVEL2_per_class']==v['LEVEL2_per_class'] and row['mean_populated_class_APH']==v['mean_populated_class_APH'];normalized={'artifacts':sub,'manifest':manifest,'validation':v};directory=base/str(step);directory.mkdir();inputs=directory/'input';inputs.mkdir();(inputs/'expected.json').write_text(json.dumps({'receipt':normalized,'receipt_sha256':sha(evidence)}));values={}
 for stage,root,worker in [('geometry',cache/'insula/rootfs-v2','audit-norm-score-first-proposals.py'),('metrics',cache/'metrics-rootfs','audit-norm-score-first-native-metrics.py')]:
  out=directory/stage;out.mkdir();w=Path('.scratch')/worker;digest=sha(w);worker_pins[worker]=digest
  command=launch_plan(root,code,original/'prepared',out,['python','/tmp/worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(w.resolve()),'/tmp/worker.py','--ro-bind',str(inputs/'expected.json'),'/tmp/expected.json','--ro-bind',str(original/'scored'),'/tmp/scored','--ro-bind',str(cache/('scientific-processing/norm-'+variant+'-v1')/('checkpoint-%04d'%step)),'/tmp/heads','--ro-bind',str(cache/'scientific-processing/overfit-point-frames-v1'),'/tmp/physical','--ro-bind',str(cache/'scientific-processing/overfit-box-targets-v1'),'/tmp/boxes']
  with (out/'live.log').open('w') as log:run=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,timeout=700)
  assert run.returncode==0,(step,stage,(out/'live.log').read_text());assert sha(w)==digest
  checks.append({'step':step,'name':stage,'command':command,'exit_code':0,'worker_sha256':digest});artifacts.update({str(p):sha(p) for p in out.iterdir()});values[stage]=json.loads((out/'check.json').read_text())
 validation.append({'step':step,'checks':values});print('AUDITED geometry/export/native replay',step,flush=True)
 (code/('research/norm-'+variant+'-score-first-audit-progress.json')).write_text(json.dumps({'admitted_checkpoints':len(validation),'expected_checkpoints':len(receipt['validation']['curve']),'admissions':validation},indent=2)+'\n')
assert all(sha(Path('.scratch')/name)==h for name,h in worker_pins.items())
result={'checks':checks,'runtime_locks':locks,'producer_evidence_sha256':sha(evidence),'worker_hashes':worker_pins,'validation':validation,'artifacts':artifacts,'scope':'all sampled checkpoint predictions independently decoded/suppressed/geometry checked; protobuf fields reread and every native metric rerun'};(code/('research/norm-'+variant+'-score-first-audits-verified.json')).write_text(json.dumps(result,indent=2)+'\n');print('PASS all sampled checkpoint independent native audits',flush=True)
