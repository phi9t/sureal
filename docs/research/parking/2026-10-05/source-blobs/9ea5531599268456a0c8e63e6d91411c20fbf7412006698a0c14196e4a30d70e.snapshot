import pathlib,json,hashlib,subprocess,sys,shutil,os,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-real-metric-reference-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_metric_reference.cc',code/'reference.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();checks=[];start=time.monotonic();inputs=R/'inputs';inputs.mkdir();os.link(C/'insula/motion-native-inventory-v2/output/selected.pb',inputs/'training.pb');os.link(C/'insula/motion-validation-native-inventory-v1/output/selected.pb',inputs/'validation.pb')
for split in ['training','validation']:
 for offset in [0,2]:os.link(C/'insula/motion-real-metric-v2'/split/f'predictions-{offset}.textproto',inputs/f'{split}-{offset}.textproto')
for split in ['training','validation']:
 out=R/split;out.mkdir();command=launch_plan(root,code,inputs,out,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/reference.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/reference && /outputs/reference /source/'+split+'.pb /source/'+split+'-0.textproto /outputs/expected-0.tsv && /outputs/reference /source/'+split+'.pb /source/'+split+'-2.textproto /outputs/expected-2.tsv']);r=subprocess.run(command,capture_output=True,text=True,timeout=120);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks.append({'command':command,'exit_code':0});print(r.stdout)
receipt={'checks':checks,'runtime_lock':lock,'pins':{str(p):sha(p) for folder in [code,inputs] for p in folder.iterdir()},'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for split in ['training','validation'] for p in (R/split).iterdir() if p.is_file()},'scope':'independent native truth/prediction reparse and literal Euclidean/count derivation; scorer reconciliation pending'};(P/'research/motion-real-metric-reference-execution.json').write_text(json.dumps(receipt,indent=2))
