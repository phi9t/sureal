import pathlib,json,sys,hashlib,subprocess,os,signal
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.staging_lease import staging_lease
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';receipt=P/'research/motion-training-source-acquired.json';r=json.loads(receipt.read_text());payload=pathlib.Path(r['local_source']);sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();R=C/'insula/motion-training-raw-release-v1';R.mkdir();framing=P/'research/motion-training-framing-live-verified.json';native=P/'research/motion-training-native-inventory-verified.json';f=json.loads(framing.read_text());n=json.loads(native.read_text());assert r['hdfs_readback_exact'] and r['source_sha256']==f['input_sha256']==n['input_sha256'];assert f['validation']['complete_source_bytes']==int(r['source']['size']) and f['validation']['records']==492 and n['exit_code']==0
with staging_lease(C/'raw-staging.lock'):
 assert sha(payload)==r['source_sha256'];proof={'source_receipt_sha256':sha(receipt),'framing_receipt_sha256':sha(framing),'native_inventory_receipt_sha256':sha(native),'source_sha256':r['source_sha256'],'hdfs_uri':r['hdfs_uri'],'local_source':str(payload),'bytes':payload.stat().st_size,'scope':'only fully inventoried pilot raw shard; selected native truth/causal observations and original source receipts retained'};(R/'release-planned.json').write_text(json.dumps(proof,indent=2));payload.unlink();copy=R/'recovery.tfrecord';cli=pathlib.Path.home()/'workspace/waystone/scripts/waystone';cmd=[str(cli),'--error-format','json','--auth-source','token-file','get',r['hdfs_uri'],str(copy)];p=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,start_new_session=True)
 try:o,e=p.communicate(timeout=120)
 except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.communicate();raise RuntimeError('bounded raw recovery timed out')
 (R/'recovery.log').write_text(o+e);assert p.returncode==0,e[-1000:];assert sha(copy)==r['source_sha256'] and copy.stat().st_size==int(r['source']['size']);copy.unlink();proof.update({'recovery_command':cmd,'recovery_exit_code':0,'repeat_hdfs_readback_exact':True,'raw_source_released':True,'selected_truth_retained':(C/'insula/motion-native-inventory-v2/output/selected.pb').exists(),'causal_observations_retained':(C/'insula/motion-native-link-v5/output/observations.pb').exists()});assert proof['selected_truth_retained'] and proof['causal_observations_retained'];(R/'released.json').write_text(json.dumps(proof,indent=2));(P/'research/motion-training-raw-release-verified.json').write_text(json.dumps(proof,indent=2));print('RELEASED RAW',proof['bytes'],'with exact recovery')
