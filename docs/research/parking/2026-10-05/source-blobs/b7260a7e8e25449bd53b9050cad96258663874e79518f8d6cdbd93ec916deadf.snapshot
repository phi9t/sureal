import pathlib,json,hashlib,subprocess,sys,shutil,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';a=json.loads((P/'research/motion-validation-extension-acquired.json').read_text());ext=pathlib.Path(a['local_source']);base=C/'insula/motion-validation-native-inventory-v1/output/selected.pb';R=C/'insula/motion-validation-native-link-v1';R.mkdir();code=R/'code';code.mkdir();out=R/'output';out.mkdir();shutil.copy('.scratch/motion_link.cc',code/'link.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');shutil.copy(C/'insula/motion-causal-live-b/output/motion_causal_project',code/'causal');shutil.copy(base,code/'base.pb');root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for p in code.iterdir()};script='g++ -std=c++17 -O2 -I/generated /experiment/link.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/link && /outputs/link join /experiment/base.pb /source/source.tfrecord /outputs/merged.pb 11818a3a928aaefa && /experiment/causal /outputs/merged.pb /outputs/observations.pb && /outputs/link check /outputs/merged.pb /outputs/observations.pb /outputs/future.pb';command=launch_plan(root,code,ext.parent,out,['/bin/sh','-c',script]);start=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=180);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr
negative=launch_plan(root,code,ext.parent,out,['/experiment/causal','/outputs/future.pb','/outputs/forbidden.pb']);n=subprocess.run(negative,capture_output=True,text=True,timeout=30);(out/'future-rejection.log').write_text(n.stdout+n.stderr);assert n.returncode!=0 and not (out/'forbidden.pb').exists();assert 'sensor coverage' in n.stderr;assert all(sha(p)==h for p,h in pins.items());refusals=[]
for label,base_arg,key in [('wrong-key','/experiment/base.pb','wrong'),('duplicate','/outputs/merged.pb','11818a3a928aaefa')]:
 cmd=launch_plan(root,code,ext.parent,out,['/outputs/link','join',base_arg,'/source/source.tfrecord','/outputs/'+label+'.pb',key]);bad=subprocess.run(cmd,capture_output=True,text=True,timeout=30);(out/(label+'.log')).write_text(bad.stdout+bad.stderr);assert bad.returncode!=0 and not (out/(label+'.pb')).exists();refusals.append({'command':cmd,'exit_code':bad.returncode})
receipt={'command':command,'exit_code':0,'key_and_duplicate_refusals':refusals,'future_rejection_command':negative,'future_rejection_exit_code':n.returncode,'runtime_lock':lock,'input_sha256':sha(ext),'source_pins':pins,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'rss_scope':'build/link/projection/check children','artifacts':{str(p):sha(p) for p in out.iterdir() if p.is_file()},'scope':'native selected validation scenario-extension correspondence and causal prefix with future sensor refusal; codebook/decoded lidar/validation/native metric handoff pending'};(P/'research/motion-validation-native-link-verified.json').write_text(json.dumps(receipt,indent=2));print(r.stdout+n.stderr)
