import hashlib,json,math
from pathlib import Path
import numpy as np
import torch
from pipeline.pillar_detector import PillarDetector
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
e=json.loads(Path('/tmp/audit-input/expected.json').read_text());r=e['receipt'];v=r['validation']
assert sha('/experiment/research/native-overfit-execution-verified.json')==e['receipt_sha256']
for p,h in r['candidate_hashes'].items():assert sha(Path('/experiment')/p)==h
for p,h in r['artifacts'].items():assert sha(Path('/tmp/retained')/Path(p).name)==h
assert sha('/tmp/inputs/manifest.json')==r['manifest_sha256']
assert v['updates']==len(v['step_records'])==2000
rng=np.random.Generator(np.random.PCG64(17));order=[]
for step,item in enumerate(v['step_records']):
 if not order:order=rng.permutation(16).tolist()
 assert item['frame_index']==order.pop(0) and item['step']==step+1
 assert math.isfinite(item['loss']) and item['loss']>=0 and math.isfinite(item['gradient_norm_before_clip'])
checkpoint=torch.load('/tmp/retained/checkpoint.pt',weights_only=True,map_location='cpu');assert checkpoint['steps']==2000 and checkpoint['manifest_sha256']==r['manifest_sha256']
for state in checkpoint['optimizer']['state'].values():
 assert state['step'].item()==2000
 assert all(torch.isfinite(x).all() for x in state.values())
torch.manual_seed(17);torch.backends.cuda.matmul.allow_tf32=False;torch.backends.cudnn.allow_tf32=False;torch.backends.cudnn.deterministic=True;torch.backends.cudnn.benchmark=False;torch.use_deterministic_algorithms(True)
def new_model():return PillarDetector(nx=512,ny=512,classes=4,anchors_per_cell=8,cell_size=(.25,.25),origin=(-64.,-64.)).cuda().eval()
initial_model=new_model();final_model=new_model();final_model.load_state_dict(checkpoint['model'])
def literal_loss(heads,labels,targets,directions):
 logits=heads['classification'].astype(np.float64);boxes=heads['box_residuals'].astype(np.float64);d=heads['direction'].astype(np.float64)
 positive=labels>0;normalizer=max(1,int(positive.sum()));y=(labels[:,None]==np.arange(1,5)[None,:]).astype(float)
 p=np.exp(-np.logaddexp(0,-logits));correct=y*p+(1-y)*(1-p);alpha=.25*y+.75*(1-y)
 ce=np.logaddexp(0,logits)-y*logits
 classification=float((alpha*(1-correct)**2*ce*(labels>=0)[:,None]).sum()/normalizer)
 diff=boxes-targets;diff[:,6]=np.sin(diff[:,6]);a=np.abs(diff);smooth=np.where(a<1/9,4.5*diff**2,a-1/18)
 localization=float((smooth*positive[:,None]).sum()/normalizer)
 direction=float(((np.logaddexp(d[:,0],d[:,1])-d[np.arange(len(d)),directions])*positive).sum()/normalizer)
 return {'classification':classification,'localization':localization,'direction':direction,'total':classification+2*localization+.2*direction}
for index,frame in enumerate(r['manifest']['frames']):
 directory=Path('/tmp/native')/frame['relative_directory']
 for name,h in frame['sha256'].items():assert sha(directory/name)==h
 with np.load(directory/'observations.npz',allow_pickle=False) as data:
  points=torch.from_numpy(data['points'].astype(np.float32)).cuda();counts=torch.from_numpy(data['counts']).cuda();coordinates=torch.from_numpy(data['coordinates']).cuda()
 with np.load(directory/'targets.npz',allow_pickle=False) as data:labels=data['labels'];targets=data['box_targets'].astype(np.float32).astype(np.float64);directions=data['direction_targets']
 for model,mode in [(initial_model,'initial'),(final_model,'final')]:
  with torch.no_grad():heads={k:x[0].cpu().numpy() for k,x in model(points,counts,coordinates,batch_size=1).items()}
  if mode=='final':
   with np.load(Path('/tmp/retained')/('heads-%02d.npz'%index),allow_pickle=False) as data:
    for k in heads:np.testing.assert_array_equal(heads[k],data[k])
  losses=literal_loss(heads,labels,targets,directions)
  for k,value in losses.items():assert math.isclose(value,v[mode+'_eval_losses'][index][k],rel_tol=2e-5,abs_tol=2e-5),(mode,index,k,value,v[mode+'_eval_losses'][index][k])
 print('REPLAYED',index+1,flush=True)
a=sum(x['total'] for x in v['initial_eval_losses'])/16;b=sum(x['total'] for x in v['final_eval_losses'])/16
assert math.isclose(a,v['initial_mean_loss']) and math.isclose(b,v['final_mean_loss']) and math.isclose(1-b/a,v['loss_reduction_fraction'])
assert v['loss_gate_passed']==(1-b/a>=.8)
Path('/outputs/check.json').write_text(json.dumps({'optimizer_updates':2000,'all16_final_heads_exactly_replayed':True,'initial_and_final_losses_independently_reconciled':True,'loss_gate_passed':v['loss_gate_passed'],'loss_reduction_fraction':1-b/a,'scope':'live checkpoint/head replay and literal loss audit; native APH acceptance and heldout research remain separate'}));print('PASS independent live overfit training audit')
