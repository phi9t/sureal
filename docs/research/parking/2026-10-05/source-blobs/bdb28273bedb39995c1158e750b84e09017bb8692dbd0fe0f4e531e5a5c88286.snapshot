"""Lead-only current-base admission assembly; no native or Kata effects."""
import argparse
import copy
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess

BASE = Path(__file__).resolve().parent
HEAD = '5e65b3f75a35e578b8bc7009f6de0e50494caa15'
ROOT = Path('/data02/home/philip.yang/workspace/sureal')


def ref(path):
    path = Path(path)
    assert path.is_absolute() and path.resolve() == path
    return {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def read(path):
    return json.loads(Path(path).read_text())


def save(name, value):
    path = BASE / name
    with path.open('xb') as stream:
        stream.write((json.dumps(value, sort_keys=True, separators=(',', ':')) + '\n').encode())
        stream.flush()
        os.fsync(stream.fileno())
    descriptor = os.open(BASE, os.O_DIRECTORY)
    os.fsync(descriptor)
    os.close(descriptor)
    return ref(path)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--package', type=Path, required=True)
    parser.add_argument('--review', type=Path, required=True)
    parser.add_argument('--reader', type=Path, required=True)
    args = parser.parse_args()
    package, review = read(args.package), read(args.review)
    assert review['verdict'] == 'pass'
    assert review['candidate'] == package['candidate']
    assert review['source'] == package['source']
    assert review['reviewer_native_thread_id'] == '01a105a5-de93-74a3-adad-c5184f54a751'
    auditor = {key: package[key] for key in ('candidate', 'materialization', 'retention', 'source')}
    auditor['review'] = ref(args.review)
    assert args.reader.is_relative_to(Path(auditor['source']))
    layout = read(BASE / 'native-stop-prospective-layout-v8.json')
    plan = layout['fixture_plan']
    assert plan['workspace_base'] == HEAD
    for repository in (ROOT, Path(plan['workspace'])):
        assert subprocess.check_output(['/usr/bin/git', '--no-optional-locks', '-C', str(repository), 'rev-parse', 'HEAD']).decode().strip() == HEAD
        assert not subprocess.check_output(['/usr/bin/git', '--no-optional-locks', '-C', str(repository), 'status', '--porcelain=v1', '--untracked-files=all'])
    assert not Path(plan['fixture_output']).exists()
    assert not Path(plan['observer_output']).exists()
    assert not any(Path(plan['channel_root']['path']).iterdir())
    tools = {'sudo': ref('/usr/bin/sudo'), 'python': plan['tools']['python']}
    resources = {'deadline_ms': 2000, 'max_stdout_bytes': 131072, 'max_request_bytes': 65536, 'max_targets': 64}
    authority = read(BASE / 'stop-preflight-user-authority-v8.json')
    authority.update(fixture_id=plan['fixture_id'], auditor=auditor,
        prospective_layout=ref(BASE / 'native-stop-prospective-layout-v8.json'),
        previous_prepared_authority=ref(BASE / 'stop-preflight-user-authority-v8.json'),
        scope='One fresh current-base nonmanaged stop-capability fixture; source-admitted read-only gap coverage only; original stop/native/process/resource gates unchanged. No managed dispatch, goal, Kata, science mutation, cleanup or old-effect retries.',
        privileged_writer_coverage={'owner_uid': os.getuid(), 'roots': [plan['workspace'], plan['fixture_output'], plan['common_git']],
            'reader': ref(args.reader), 'tools': tools, 'resources': resources,
            'design_review': ref('/data02/home/philip.yang/devx/tmp/collab50-writer-gap-coverage-design-review-v1.json'),
            'access_feasibility': ref(BASE / 'privileged-readability-proof-v1/actual-command.json')})
    authority_ref = save('stop-preflight-user-authority-v9.json', authority)
    coverage = {'schema_version': 1, 'kind': 'ScopedPrivilegedWriterCoverageAdmission',
        'owner_uid': os.getuid(), 'roots': [plan['workspace'], plan['fixture_output'], plan['common_git']],
        'reader': ref(args.reader), 'auditor': auditor, 'tools': tools,
        'user_authority': authority_ref, 'resources': resources}
    coverage_ref = save('writer-coverage-admission-v1.json', coverage)
    for role, old_name, new_name in (
        ('static', 'static-preflight-admission-base-v3.json', 'static-preflight-admission-base-v4.json'),
        ('observer', 'observer-live-admission-base-v1.json', 'observer-live-admission-base-v2.json'),
        ('operator', 'operator-live-admission-base-v1.json', 'operator-live-admission-base-v2.json')):
        value = read(BASE / old_name)
        value.update(auditor=auditor, fixture_plan=copy.deepcopy(plan), user_authority=authority_ref)
        value['coverage'] = ref(Path(auditor['source']) / 'docs/collaboration/coverage.json')
        if role == 'static':
            value['resources']['output_root'] = str(BASE / 'native-stop-static-v4')
            value['writer_coverage'] = coverage_ref
        elif role == 'observer':
            value['resources']['output_root'] = str(BASE / 'native-stop-observer-v8')
            value['handoff_path'] = str(Path(plan['observer_output']) / 'fixture-bound.json')
            value['recorder_exit_path'] = str(Path(plan['observer_output']) / 'recorder-host-exit.json')
            value['writer_coverage'] = coverage_ref
            value.pop('static_preflight')
        else:
            for key in ('fixture_id', 'workspace', 'workspace_base', 'workspace_identity', 'common_git_identity'):
                value[key] = copy.deepcopy(plan[key])
            value['output'] = plan['fixture_output']
            value['observer_output'] = plan['observer_output']
            value['capture_close_path'] = str(Path(plan['observer_output']) / 'channel-close-request.json')
            value['notification_channel'] = {'channel_root': copy.deepcopy(plan['channel_root'])}
            argv = [value['tools']['systemd_run']['path'], '--user', '--scope', '--unit', 'sureal-sustained-collab-' + plan['fixture_id'],
                '--property', 'MemoryMax=134217728', '--property', 'MemorySwapMax=0', '--', value['tools']['python']['path'], '-I', '-B',
                value['operator_source']['path'], 'payload', '--output', str(Path(plan['fixture_output']) / 'payload'), '--fixture-id', plan['fixture_id']]
            command = shlex.join(argv)
            value['command_sha256'] = hashlib.sha256(command.encode()).hexdigest()
            value['rendered_command_sha256'] = hashlib.sha256(shlex.join(['/bin/bash', '-lc', command]).encode()).hexdigest()
            value.pop('static_preflight')
        save(new_name, value)
    driver = read(BASE / 'static-preflight-driver-admission-v3.json')
    driver.update(auditor=auditor, fixture_id=plan['fixture_id'], fixture_plan=copy.deepcopy(plan),
        coverage=ref(Path(auditor['source']) / 'docs/collaboration/coverage.json'), user_authority=authority_ref,
        output=str(BASE / 'native-stop-static-driver-v4'), static_admission=ref(BASE / 'static-preflight-admission-base-v4.json'))
    driver['resources']['output_root'] = str(BASE / 'native-stop-static-v4')
    print(json.dumps({'static_driver': save('static-preflight-driver-admission-v4.json', driver),
        'writer_coverage': coverage_ref, 'native_effects': False, 'managed_dispatch': False}))


if __name__ == '__main__':
    main()
