from pathlib import Path
import hashlib,json,sys,subprocess
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();cache=Path.home()/'.cache/waystone/waymo-perception';r=json.loads((code/'research/architecture-retain64-cache-verified.json').read_text());scene,stamp=r['frame']['identity'].split(':');original=cache/'scientific-processing/overfit-native-cache-v1'/scene/stamp;retained=cache/'scientific-processing/architecture-retain64-cache-v1'/scene/stamp;physical=cache/'scientific-processing/overfit-point-frames-v1'/scene/'producer';boxes=cache/'scientific-processing/overfit-box-targets-v1'/scene/'producer';root=cache/'insula/rootfs-v2';verify_rootfs(root,r['runtime_lock']['rootfs_sha256']);output=cache/'insula/architecture-retention-support-v1';output.mkdir();worker=Path('.scratch/architecture-retention-support.py').resolve();digest=sha(worker);command=launch_plan(root,code,physical,output,['python','/tmp/worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(worker),'/tmp/worker.py','--ro-bind',str(original/'input'),'/tmp/input','--ro-bind',str(original/'producer'),'/tmp/original','--ro-bind',str(retained/'producer'),'/tmp/retained','--ro-bind',str(boxes),'/tmp/boxes'];run=subprocess.run(command,capture_output=True,text=True,timeout=120);(output/'live.log').write_text(run.stdout+run.stderr);print(run.stdout+run.stderr);assert run.returncode==0 and sha(worker)==digest
(code/'research/architecture-retention-support-verified.json').write_text(json.dumps({'checks':[{'command':command,'exit_code':0}],'runtime_lock':r['runtime_lock'],'retention_evidence_sha256':sha(code/'research/architecture-retain64-cache-verified.json'),'worker_sha256':digest,'validation':json.loads((output/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in output.iterdir()}},indent=2)+'\n')
