from pathlib import Path
import time,json,sys,hashlib,subprocess
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();r=code/'research';p=r/'architecture-context_pfn-exclusive-execution-verified.json'
while not p.exists():time.sleep(2)
a=json.loads((r/'architecture-context_pfn-execution-verified.json').read_text());b=json.loads(p.read_text());cache=Path.home()/'.cache/waystone/waymo-perception';root=cache/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);base=cache/'insula/architecture-context-exclusive-equality-v1';base.mkdir();inputs=base/'inputs';inputs.mkdir();out=base/'output';out.mkdir();original=cache/'scientific-processing/architecture-context_pfn-v1';repeat=cache/'scientific-processing/architecture-context_pfn-exclusive-v2';(inputs/'expected.json').write_text(json.dumps({'original':a,'repeat':b,'original_root':str(original),'repeat_root':str(repeat)}));worker=Path('.scratch/audit-architecture-exclusive-equality.py').resolve();h=sha(worker);command=launch_plan(root,code,original,out,['python','/tmp/worker.py']);i=command.index('--');command[i:i]=['--ro-bind',str(worker),'/tmp/worker.py','--ro-bind',str(inputs/'expected.json'),'/tmp/expected.json','--ro-bind',str(repeat),'/tmp/repeat'];run=subprocess.run(command,capture_output=True,text=True,timeout=120);(out/'live.log').write_text(run.stdout+run.stderr);print(run.stdout+run.stderr);assert run.returncode==0 and sha(worker)==h;(r/'architecture-context-exclusive-equality-verified.json').write_text(json.dumps({'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'original_evidence_sha256':sha(r/'architecture-context_pfn-execution-verified.json'),'exclusive_evidence_sha256':sha(p),'worker_sha256':h,'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in out.iterdir()}},indent=2)+'\n')
