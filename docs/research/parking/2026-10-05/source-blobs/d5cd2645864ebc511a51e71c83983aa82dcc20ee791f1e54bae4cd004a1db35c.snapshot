import json,pathlib,sys,hashlib,subprocess,shutil,os,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-codebook-live-v1';R.mkdir();code=R/'code';code.mkdir();inputs=R/'inputs';inputs.mkdir();nativeout=R/'native-output';nativeout.mkdir();output=R/'feature-output';output.mkdir();srcbook=pathlib.Path(json.loads((P/'research/motion-codebook-acquired.json').read_text())['local_source']);srcobs=C/'insula/motion-native-link-v5/output/observations.pb';os.link(srcbook,inputs/'codebook.npy');os.link(srcobs,inputs/'observations.pb');shutil.copy('.scratch/motion_tokens.cc',code/'tokens.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');shutil.copy('.scratch/motion_codebook_fixture.py',code/'features.py');sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for p in code.iterdir()};inputpins={str(p):sha(p) for p in inputs.iterdir()};checks=[];start=time.monotonic()
def stage(label,root,source,out,command):
 lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);args=launch_plan(root,code,source,out,command);r=subprocess.run(args,capture_output=True,text=True,timeout=120);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks.append({'command':args,'exit_code':0,'runtime_lock':lock});print(r.stdout)
stage('native',C/'motion-cli-rootfs-v2',inputs,nativeout,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/tokens.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/tokens && /outputs/tokens /source/observations.pb /outputs/tokens.tsv']);featureinput=R/'feature-input';featureinput.mkdir();os.link(nativeout/'tokens.tsv',featureinput/'tokens.tsv');os.link(srcbook,featureinput/'codebook.npy');stage('features',C/'insula/rootfs-v2',featureinput,output,['python','/experiment/features.py']);assert all(sha(p)==h for p,h in pins.items());assert all(sha(p)==h for p,h in inputpins.items());report=json.loads((output/'check.json').read_text());assert report['peak_rss_kib']*1024<16*1024**3;receipt={'checks':checks,'source_pins':pins,'input_pins':inputpins,'validation':report,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for folder in [nativeout,output] for p in folder.iterdir() if p.is_file()},'scope':'live native observation-only camera token extraction and codebook row correspondence; no forecasting quality or RGB claim'};(P/'research/motion-codebook-live-verified.json').write_text(json.dumps(receipt,indent=2));print('ADMITTED motion codebook features')
