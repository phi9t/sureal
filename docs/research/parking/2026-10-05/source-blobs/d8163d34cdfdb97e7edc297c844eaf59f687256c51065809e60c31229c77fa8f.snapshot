import hashlib,json,subprocess,sys
from pathlib import Path
exp=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(exp));from pipeline.runtime_identity import verify_rootfs
base=Path.home()/'.cache/waystone/waymo-perception/insula/camera-native-bridge-a';run=base.parent/'camera-residual-structure-a';run.mkdir(exist_ok=False)
old=json.loads((exp/'research/camera-native-projection-residuals.json').read_text());cmd=old['checks'][0]['command'];cmd=cmd[:cmd.index('--')];cmd[cmd.index(str(base/'audit'))]=str(run)
verify_rootfs(Path(cmd[4]),'aa18eaaca3c65821d1febcbafefa9d0d0a2a6dae03aa9bc55c7d9e19e769246e')
script="""import json,numpy as np
from pathlib import Path
with np.load('/tmp/native-input/native.npz',allow_pickle=False) as a:cp=a['camera_projection']
p=np.loadtxt('/tmp/projected/projection.csv',delimiter=',');n=len(cp);assert p.shape==(n,5);np.testing.assert_array_equal(p[:,0],np.arange(n));slots=cp.reshape(n,2,3)
ids=[];uv=[]
for s in range(2):
 c,u,v=slots[:,s,:].T;mask=(c==1)&(u>=0)&(u<1920)&(v>=0)&(v<1280)&(p[:,1]==1);ids.extend(np.flatnonzero(mask));uv.extend(slots[mask,s,1:3])
ids=np.asarray(ids);uv=np.asarray(uv);delta=p[ids,2:4]-uv;depth=p[ids,4];norm=np.linalg.norm(delta,axis=1)
def summary(mask):
 d=delta[mask];return {'count':int(mask.sum()),'mean_delta_uv':d.mean(0).tolist() if len(d) else None,'p50_p95_l2':np.quantile(norm[mask],[.5,.95]).tolist() if len(d) else None}
r={'slots':len(ids),'depth_bins':{},'horizontal_bins':{},'vertical_bins':{},'quantization_diagnostics':{}}
for name,x,edges in [('depth_bins',depth,[0,10,20,40,80,1000]),('horizontal_bins',uv[:,0],[0,480,960,1440,1920]),('vertical_bins',uv[:,1],[0,320,640,960,1280])]:
 for lo,hi in zip(edges[:-1],edges[1:]):r[name][str(lo)+':'+str(hi)]=summary((x>=lo)&(x<hi))
for name,fn in [('nearest',np.rint),('floor',np.floor),('ceil',np.ceil)]:
 diff=fn(p[ids,2:4])-uv;r['quantization_diagnostics'][name]={'exact_both_axes':int((diff==0).all(1).sum()),'within_one_both_axes':int((abs(diff)<=1).all(1).sum())}
r['beyond_floor_unit_square']=int(((delta<0)|(delta>=1)).any(1).sum());r['scope']='one unchanged native engineering frame; diagnostics only; no fitted correction or visibility promotion'
Path('/outputs/results.json').write_text(json.dumps(r,indent=2));print(json.dumps(r))
"""
cmd+=['--','python','-c',script];ret=subprocess.run(cmd,capture_output=True,text=True);(run/'live.log').write_text(ret.stdout+ret.stderr);assert ret.returncode==0,ret.stderr
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();prior=json.loads((exp/'research/camera-native-projection-executed.json').read_text());assert sha(base/'receipt.json')==prior['receipt_sha256'];assert sha(base/'output/projection.csv')==prior['artifacts']['output/projection.csv']
d={'checks':[{'command':cmd,'exit_code':ret.returncode}],'runtime_sha256':'aa18eaaca3c65821d1febcbafefa9d0d0a2a6dae03aa9bc55c7d9e19e769246e','projection_receipt_sha256':prior['receipt_sha256'],'script_sha256':sha(__file__),'validation':json.loads((run/'results.json').read_text()),'artifacts':{p.name:sha(p) for p in run.iterdir() if p.is_file()}}
(run/'receipt.json').write_text(json.dumps(d,indent=2));d['receipt']=str(run/'receipt.json');d['receipt_sha256']=sha(run/'receipt.json');(exp/'research/camera-residual-structure-verified.json').write_text(json.dumps(d,indent=2));print(ret.stdout)
