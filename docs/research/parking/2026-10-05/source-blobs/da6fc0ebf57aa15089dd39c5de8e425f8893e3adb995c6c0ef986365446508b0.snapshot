import pathlib,json,sys,subprocess,hashlib,shutil,time,resource,os
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-real-pooled-v2';R.mkdir();code=R/'code';code.mkdir();inputs=R/'inputs';inputs.mkdir()
(code/'motion-evaluation/pooled').mkdir(parents=True)
for name in ['CMakeLists.txt','motion_metrics_pooled_main.cc']:shutil.copy(P/'motion-evaluation/pooled'/name,code/'motion-evaluation/pooled'/name)
shutil.copy(P/'motion-evaluation/ingestion/native_metric_handoff_reference.cc',code/'reference.cc');shutil.copy(P/'motion-evaluation/ingestion/native_source_inventory.cc',code/'native_source_inventory.cc');shutil.copy(P/'motion-evaluation/ingestion/pooled_handoff_check.py',code/'check.py')
sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();parent=json.loads((P/'research/motion-real-metric-execution.json').read_text());assert all(sha(p)==h for p,h in parent['artifacts'].items())
for split,folder in [('training','motion-native-inventory-v2'),('validation','motion-validation-native-inventory-v1')]:
 dest=inputs/split;dest.mkdir();os.link(C/'insula'/folder/'output/selected.pb',inputs/(split+'.pb'))
 for name in ['scenario.textproto','predictions-0.textproto','predictions-2.textproto','config.textproto']:os.link(C/'insula/motion-real-metric-v2'/split/name,dest/name)
assert (inputs/'training/config.textproto').read_bytes()==(inputs/'validation/config.textproto').read_bytes()
for a,b in [(0,0),(0,2),(2,0),(2,2)]:
 (inputs/f'pairs-{a}-{b}.txt').write_text(f'/source/training/scenario.textproto /source/training/predictions-{a}.textproto\n/source/validation/scenario.textproto /source/validation/predictions-{b}.textproto\n')
(inputs/'pairs-duplicate.txt').write_text('/source/training/scenario.textproto /source/training/predictions-0.textproto\n'*2);(inputs/'pairs-wrong-id.txt').write_text('/source/training/scenario.textproto /source/validation/predictions-0.textproto\n')
pins={str(p):sha(p) for folder in [code,inputs] for p in folder.rglob('*') if p.is_file()};root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);out=R/'native';out.mkdir();shell='cmake -S /experiment/motion-evaluation/pooled -B /outputs/pooled-build >/outputs/build.log 2>&1 && cmake --build /outputs/pooled-build -j2 >>/outputs/build.log 2>&1 && g++ -std=c++17 -O2 -I/generated /experiment/reference.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/reference'
for split in ['training','validation']:
 for offset in [0,2]:shell+=f' && /outputs/reference /source/{split}.pb /source/{split}/predictions-{offset}.textproto /outputs/{split}-expected-{offset}.tsv'
for a,b in [(0,0),(0,2),(2,0),(2,2)]:shell+=f' && /outputs/pooled-build/compute_motion_metrics_pooled /source/pairs-{a}-{b}.txt /source/training/config.textproto /outputs/pooled-{a}-{b}.json'
# Expected failures run separately: a compiler failure cannot count as refusal.
cmd=launch_plan(root,code,inputs,out,['/bin/sh','-c',shell]);start=time.monotonic();r=subprocess.run(cmd,capture_output=True,text=True,timeout=120);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks=[{'command':cmd,'exit_code':0}]
for fault in ['duplicate','wrong-id']:
 command=launch_plan(root,code,inputs,out,['/outputs/pooled-build/compute_motion_metrics_pooled','/source/pairs-'+fault+'.txt','/source/training/config.textproto','/outputs/refused-'+fault+'.json']);r=subprocess.run(command,capture_output=True,text=True,timeout=30);(out/(fault+'.log')).write_text(r.stdout+r.stderr);assert r.returncode==1 and not (out/('refused-'+fault+'.json')).exists();checks.append({'command':command,'exit_code':1,'expected_exit_code':1})
output=R/'check';output.mkdir();cpu=C/'insula/rootfs-v2';cpulock=json.loads(pathlib.Path(str(cpu)+'.lock.json').read_text());verify_rootfs(cpu,cpulock['rootfs_sha256']);cmd=launch_plan(cpu,code,out,output,['python','/experiment/check.py']);r=subprocess.run(cmd,capture_output=True,text=True,timeout=60);(output/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks.append({'command':cmd,'exit_code':0});assert all(sha(p)==h for p,h in pins.items())
receipt={'checks':checks,'native_runtime_lock':lock,'check_runtime_lock':cpulock,'source_pins':pins,'parent_metric_execution_sha256':sha(P/'research/motion-real-metric-execution.json'),'validation':json.loads((output/'check.json').read_text()),'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for folder in [out,output] for p in folder.rglob('*') if p.is_file()},'scope':'acquired-native pooled oracle metric parity only; official train and validation are mixed only in this diagnostic, never scientific scoring'};(P/'research/motion-real-pooled-native-truth-verified.json').write_text(json.dumps(receipt,indent=2));print(r.stdout);print('PASS live real native pooled metric handoff')
