import json,hashlib,subprocess,sys
from pathlib import Path
exp=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(exp));from pipeline.runtime_identity import verify_rootfs
cache=Path.home()/'.cache/waystone/waymo-perception/insula';base=cache/'camera-native-bridge-a';sam=cache/'sam-native-image-all-a';run=cache/'sam-boundary-support-a';run.mkdir(exist_ok=False)
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();teacher=json.loads((exp/'research/sam-native-image-all-verified.json').read_text());assert sha(sam/'receipt.json')==teacher['receipt_sha256'];assert sha(sam/'output/masks.npz')==teacher['artifacts']['output/masks.npz']
old=json.loads((exp/'research/camera-native-projection-residuals.json').read_text());cmd=old['checks'][0]['command'];cmd=cmd[:cmd.index('--')];cmd[cmd.index(str(base/'audit'))]=str(run);verify_rootfs(Path(cmd[4]),'aa18eaaca3c65821d1febcbafefa9d0d0a2a6dae03aa9bc55c7d9e19e769246e');cmd+=['--ro-bind',str(sam/'output'),'/tmp/sam']
script="""import json,time,resource,numpy as np
from pathlib import Path
start=time.monotonic()
with np.load('/tmp/sam/masks.npz',allow_pickle=False) as a:masks=a['masks'][:,0]
with np.load('/tmp/native-input/native.npz',allow_pickle=False) as a:cp=a['camera_projection']
n=len(cp);h,w=masks.shape[1:];slots=cp.reshape(n,2,3);rows=[];us=[];vs=[]
for s in range(2):
 c,u,v=slots[:,s,:].T;valid=(c==1)&(u>=0)&(u<w)&(v>=0)&(v<h);rows.extend(np.flatnonzero(valid));us.extend(u[valid]);vs.extend(v[valid])
rows=np.array(rows);u=np.array(us,dtype=np.int64);v=np.array(vs,dtype=np.int64);radii=[0,1,3,5];hits={r:np.zeros((n,len(masks)),bool) for r in radii}
for j,mask in enumerate(masks):
 integral=np.pad(mask.astype(np.int32).cumsum(0,dtype=np.int32).cumsum(1,dtype=np.int32),((1,0),(1,0)))
 for r in radii:
  valid=(u>=r)&(u+r<w)&(v>=r)&(v+r<h);keep=np.zeros(len(u),bool);uv=u[valid];vv=v[valid];area=integral[vv+r+1,uv+r+1]-integral[vv-r,uv+r+1]-integral[vv+r+1,uv-r]+integral[vv-r,uv-r];keep[valid]=area==(2*r+1)**2
  # Independent all-slot shifted pixel lookup, no integral image.
  reference=valid.copy()
  for dv in range(-r,r+1):
   for du in range(-r,r+1):reference[valid]&=mask[vv+dv,uv+du]
  np.testing.assert_array_equal(keep,reference);np.logical_or.at(hits[r][:,j],rows,keep)
for a,b in zip(radii[:-1],radii[1:]):assert not (hits[b]&~hits[a]).any()
assert int(hits[0].any(1).sum())==1486
result={'points':n,'masks':len(masks),'front_slots':len(rows),'pixel_radii':{str(r):{'unique_associated_points':int(x.any(1).sum()),'supported_masks':int(x.any(0).sum()),'point_mask_relations':int(x.sum()),'overlapping_points':int((x.sum(1)>1).sum())} for r,x in hits.items()},'elapsed_seconds':time.monotonic()-start,'peak_rss_kib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'scope':'all63 oracle-prompt SAM masks, native supplied pixels; square-neighborhood boundary diagnostic only, not physical visibility or frozen scientific thresholds'}
Path('/outputs/check.json').write_text(json.dumps(result,indent=2));print(json.dumps(result))
"""
cmd+=['--','python','-c',script];ret=subprocess.run(cmd,capture_output=True,text=True);(run/'live.log').write_text(ret.stdout+ret.stderr);assert ret.returncode==0,ret.stderr
d={'checks':[{'command':cmd,'exit_code':ret.returncode}],'runtime_sha256':'aa18eaaca3c65821d1febcbafefa9d0d0a2a6dae03aa9bc55c7d9e19e769246e','teacher_receipt_sha256':teacher['receipt_sha256'],'source_native_npz_sha256':sha(base/'input/native.npz'),'script_sha256':sha(__file__),'validation':json.loads((run/'check.json').read_text()),'artifacts':{p.name:sha(p) for p in run.iterdir() if p.is_file()}}
(run/'receipt.json').write_text(json.dumps(d,indent=2));d['receipt']=str(run/'receipt.json');d['receipt_sha256']=sha(run/'receipt.json');(exp/'research/sam-boundary-support-verified.json').write_text(json.dumps(d,indent=2));print(ret.stdout)
