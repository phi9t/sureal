from pathlib import Path
import datetime,hashlib,json,subprocess,sys,time
code=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(code))
from pipeline.runtime_identity import verify_rootfs
from pipeline.insula_entry import launch_plan
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
cache=Path.home()/'.cache/waystone/waymo-perception';source=cache/'scientific-processing/native-overfit-v1'
evidence=code/'research/native-overfit-execution-verified.json';receipt=json.loads(evidence.read_text());assert receipt['validation']['updates']==2000
for p,h in receipt['artifacts'].items():assert sha(p)==h
manifest=json.loads(json.dumps(receipt['manifest']))
for frame in manifest['frames']:
 scene,timestamp=frame['identity'].split(':');frame['physical_sha256']=sha(cache/'scientific-processing/overfit-point-frames-v1'/scene/'producer'/f'{timestamp}.npz');frame['boxes_sha256']=sha(cache/'scientific-processing/overfit-box-targets-v1'/scene/'producer/targets.json')
base=cache/'insula/native-overfit-scoring-v1';base.mkdir();inputs=base/'input';inputs.mkdir();out=cache/'scientific-processing/native-overfit-scoring-v1';out.mkdir()
(inputs/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
root=cache/'metrics-rootfs';lock=json.loads(Path(str(root)+'.lock.json').read_text());print('VERIFY metrics runtime',flush=True);verify_rootfs(root,lock['rootfs_sha256'])
worker=Path('.scratch/score-native-overfit.py').resolve();worker_sha=sha(worker)
command=launch_plan(root,code,source,out,['python','/tmp/workers/score-native-overfit.py']);i=command.index('--');command[i:i]=['--ro-bind',str(worker.parent),'/tmp/workers','--ro-bind',str(inputs),'/tmp/inputs','--ro-bind',str(cache/'scientific-processing/overfit-point-frames-v1'),'/tmp/physical','--ro-bind',str(cache/'scientific-processing/overfit-box-targets-v1'),'/tmp/boxes','--ro-bind',str(cache/'scientific-processing/overfit-native-cache-v1'),'/tmp/native']
pins={str(p.relative_to(code)):sha(p) for p in sorted((code/'pipeline').glob('*.py'))};started=datetime.datetime.now(datetime.timezone.utc).isoformat();print('RUN native final checkpoint scoring',flush=True)
with (out/'live.log').open('w') as log:run=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT,timeout=1200)
print((out/'live.log').read_text(),flush=True);assert run.returncode==0
assert sha(worker)==worker_sha and all(sha(code/p)==h for p,h in pins.items())
result={'started_utc':started,'finished_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'checks':[{'command':command,'exit_code':0}],'runtime_lock':lock,'training_evidence_sha256':sha(evidence),'worker_sha256':worker_sha,'candidate_hashes':pins,'manifest':manifest,'manifest_sha256':sha(inputs/'manifest.json'),'validation':json.loads((out/'check.json').read_text()),'artifacts':{str(p):sha(p) for p in out.iterdir()},'scope':'native training-only final-checkpoint scoring; independent retained/export/geometry audit still required'}
(code/'research/native-overfit-scoring-verified.json').write_text(json.dumps(result,indent=2)+'\n');print('RECORDED native scoring result',flush=True)
