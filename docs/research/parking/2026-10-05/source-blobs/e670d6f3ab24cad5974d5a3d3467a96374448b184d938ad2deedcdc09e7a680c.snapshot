import pathlib,json,sys,subprocess,hashlib,shutil,os,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-geometry-metadata-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_geometry_metadata.cc',code/'metadata.cc');shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');inputs=R/'inputs';inputs.mkdir();os.link(C/'insula/motion-native-link-v5/output/observations.pb',inputs/'training.pb');os.link(C/'insula/motion-validation-native-link-v1/output/observations.pb',inputs/'validation.pb');root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();pins={str(p):sha(p) for folder in [code,inputs] for p in folder.iterdir()};checks=[];start=time.monotonic()
for split in ['training','validation']:
 out=R/split;out.mkdir();command=launch_plan(root,code,inputs,out,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/metadata.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/metadata && /outputs/metadata /source/'+split+'.pb /outputs/metadata.json']);r=subprocess.run(command,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;checks.append({'command':command,'exit_code':0});print(r.stdout)
assert all(sha(p)==h for p,h in pins.items());receipt={'checks':checks,'runtime_lock':lock,'pins':pins,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for split in ['training','validation'] for p in (R/split).iterdir() if p.is_file()},'scope':'native historical calibration/frame-pose extraction only; XYZ/clock geometry parity pending'};(P/'research/motion-geometry-metadata-live-verified.json').write_text(json.dumps(receipt,indent=2))
