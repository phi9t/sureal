import pathlib,json,sys,subprocess,hashlib,shutil,time
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from advanced.archive import sha
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-pooled-finite-v2';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/test_motion_pooled_finite.py',code/'test_finite.py');shutil.copy(P/'motion-evaluation/ingestion/pooled_handoff_check.py',code/'check.py');pins={str(p):sha(p) for p in code.iterdir()};root=C/'insula/rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);source=C/'insula/motion-real-pooled-v1/native';parent=P/'research/motion-real-pooled-metric-verified.json';receipt=json.loads(parent.read_text());assert all(sha(p)==h for p,h in receipt['artifacts'].items());out=R/'green';out.mkdir();cmd=launch_plan(root,code,source,out,['python','/experiment/test_finite.py']);r=subprocess.run(cmd,capture_output=True,text=True,timeout=60);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0 and 'Ran 2 tests' in r.stderr and '\nOK\n' in r.stderr;assert all(sha(p)==h for p,h in pins.items());record={'command':cmd,'exit_code':0,'runtime_lock':lock,'parent_pooled_receipt_sha256':sha(parent),'red_receipt_sha256':sha(P/'research/motion-pooled-finite-red-verified.json'),'pins':pins,'validation':json.loads((out/'check.json').read_text()),'finite_regression_groups_passed':2,'artifacts':{str(p):sha(p) for p in out.iterdir()},'scope':'live GREEN:28 corrupt pooled-score refusals and observed/reference nonfinite tests; supersedes original20-probe checker admission only'};(P/'research/motion-pooled-finite-green-verified.json').write_text(json.dumps(record,indent=2));print(r.stdout+r.stderr)
