import argparse,json,shutil,subprocess,sys
from pathlib import Path
P=Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
from tier1.storage import sha
parser=argparse.ArgumentParser();parser.add_argument('name');parser.add_argument('--red',action='store_true');a=parser.parse_args();C=Path.home()/'.cache/waystone/waymo-perception';R=C/'insula'/a.name;R.mkdir();source=R/'source';source.mkdir();shutil.copytree(P/'motion-evaluation/ingestion',source/'ingestion',ignore=shutil.ignore_patterns('__pycache__'));pins={str(p):sha(p) for p in source.rglob('*') if p.is_file()};root=C/'insula/rootfs-v2';lock=json.loads(Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);output=R/'output';output.mkdir();cmd=launch_plan(root,source,source,output,['python','-m','unittest','discover','-s','ingestion','-p','test_delta_components.py','-v']);r=subprocess.run(cmd,capture_output=True,text=True,timeout=300);(output/'live.log').write_text(r.stdout+r.stderr);assert r.returncode!=0 and 'ModuleNotFoundError' in r.stderr if a.red else r.returncode==0,r.stderr;assert all(sha(p)==h for p,h in pins.items());receipt={'command':cmd,'exit_code':r.returncode,'expected_red':a.red,'source_pins':pins,'runtime_lock':lock,'artifacts':{str(output/'live.log'):sha(output/'live.log')}};(P/'research'/(a.name+'-verified.json')).write_text(json.dumps(receipt,indent=2));print(r.stderr)
