import pathlib,sys,json,hashlib,subprocess,shutil,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';R=C/'insula/motion-delta-check-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_fnv.cc',code/'hash.cc');shutil.copy('.scratch/motion_delta_check.py',code/'check.py');shutil.copy(P/'motion-evaluation/ingestion/delta_components.py',code/'delta_components.py');out=R/'output';out.mkdir();W=C/'scientific-processing/motion-delta-components-v1';root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);cmd=launch_plan(root,code,W,out,['/bin/sh','-c','g++ -O2 -static /experiment/hash.cc -o /outputs/hash']);build=subprocess.run(cmd,capture_output=True,text=True,timeout=60);(out/'build.log').write_text(build.stdout+build.stderr);assert build.returncode==0,build.stderr;shutil.copy(out/'hash',code/'hash');root=C/'insula/rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);command=launch_plan(root,code,W,out,['python','/experiment/check.py']);start=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=600);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;sha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest();receipt={'command':command,'exit_code':0,'build_command':cmd,'build_exit_code':0,'runtime_lock':lock,'source_pins':{str(p):sha(p) for p in code.iterdir()},'parent_native_receipt_sha256':sha(P/'research/motion-delta-native-components-verified.json'),'validation':json.loads((out/'check.json').read_text()),'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'artifacts':{str(p):sha(p) for p in out.iterdir() if p.is_file()},'scope':'independent live NumPy/scalar-native delta parity for both complete historical pilots; geometry/forecasting outcomes pending'};(P/'research/motion-delta-complete-live-verified.json').write_text(json.dumps(receipt,indent=2));print(r.stdout)
