import pathlib,json,hashlib,sys,subprocess,shutil,time,resource
P=pathlib.Path('experiments/waymo-perception').resolve();sys.path.insert(0,str(P));from pipeline.insula_entry import launch_plan
from pipeline.runtime_identity import verify_rootfs
C=pathlib.Path.home()/'.cache/waystone/waymo-perception';a=json.loads((P/'research/motion-validation-source-acquired.json').read_text());src=pathlib.Path(a['local_source']);R=C/'insula/motion-validation-native-inventory-v1';R.mkdir();code=R/'code';code.mkdir();shutil.copy('.scratch/motion_inventory.cc',code/'inventory.cc');out=R/'output';out.mkdir();root=C/'motion-cli-rootfs-v2';lock=json.loads(pathlib.Path(str(root)+'.lock.json').read_text());verify_rootfs(root,lock['rootfs_sha256']);command=launch_plan(root,code,src.parent,out,['/bin/sh','-c','g++ -std=c++17 -O2 -I/generated /experiment/inventory.cc /motion-build/libwod_motion_proto.a -lprotobuf -pthread -o /outputs/inventory && /outputs/inventory /source/source.tfrecord /outputs/scenarios.tsv /outputs/selected.pb']);start=time.monotonic();r=subprocess.run(command,capture_output=True,text=True,timeout=600);(out/'live.log').write_text(r.stdout+r.stderr);assert r.returncode==0,r.stderr;sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();receipt={'command':command,'exit_code':0,'elapsed_seconds':time.monotonic()-start,'peak_children_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'rss_scope':'build and native inventory children','runtime_lock':lock,'input_sha256':sha(src),'source_pins':{str(code/'inventory.cc'):sha(code/'inventory.cc')},'artifacts':{str(p):sha(p) for p in out.iterdir() if p.is_file()},'scope':'independent complete native CRC32C/protobuf inventory and bytewise lowest-ID training pilot selection; causal/extension/scoring gates pending'};(P/'research/motion-validation-native-inventory-verified.json').write_text(json.dumps(receipt,indent=2));print(r.stdout)
