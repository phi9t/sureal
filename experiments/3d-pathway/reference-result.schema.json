{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Surflo 3D pathway maintained-reference result",
  "type": "object",
  "required": ["schema_version", "adapter", "module_ids", "profile", "status", "network_mode", "metrics", "acceptance", "tool", "resources", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter": {"enum": ["colmap-sfm", "colmap-mvs", "orb-slam", "depth-anything-v2", "neus-facto", "nerfacto"]},
    "module_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^[0-9]{2}$"}},
    "profile": {"enum": ["smoke", "full"]},
    "status": {"const": "complete"},
    "network_mode": {"const": "offline"},
    "metrics": {
      "type": "object",
      "properties": {
        "registered_images": {"type": "integer"},
        "sparse_points": {"type": "integer"},
        "mean_reprojection_error_px": {"type": "number"},
        "dense_points": {"type": "integer"},
        "mesh_faces": {"type": "integer"},
        "camera_alignment_rmse_m": {"type": "number"},
        "accuracy_mean_m": {"type": "number"},
        "completeness_mean_m": {"type": "number"},
        "supported_completeness_mean_m": {"type": "number"},
        "undersupported_completeness_mean_m": {"type": "number"},
        "fscore_10cm": {"type": "number"},
        "input_frames": {"type": "integer"},
        "tracked_frames": {"type": "integer"},
        "tracking_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "lost_frames": {"type": "integer"},
        "tracking_recoveries": {"type": "integer"},
        "keyframes": {"type": "integer"},
        "trajectory_matches": {"type": "integer"},
        "ate_rmse_m": {"type": "number"},
        "rpe_translation_rmse_m": {"type": "number"},
        "rpe_rotation_rmse_deg": {"type": "number"},
        "endpoint_drift_m": {"type": "number"},
        "endpoint_rotation_drift_deg": {"type": "number"},
        "map_points": {"type": "integer"},
        "map_truth_points": {"type": "integer"},
        "map_accuracy_mean_m": {"type": "number"},
        "map_completeness_mean_m": {"type": "number"},
        "map_precision_10cm": {"type": "number", "minimum": 0, "maximum": 1},
        "map_recall_10cm": {"type": "number", "minimum": 0, "maximum": 1},
        "map_fscore_10cm": {"type": "number", "minimum": 0, "maximum": 1},
        "evaluated_cases": {"type": "integer", "minimum": 1},
        "evaluated_pixels": {"type": "integer", "minimum": 1},
        "valid_pixels": {"type": "integer", "minimum": 1},
        "valid_pixel_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "raw_rmse_m": {"type": "number", "minimum": 0},
        "raw_abs_rel": {"type": "number", "minimum": 0},
        "raw_delta1": {"type": "number", "minimum": 0, "maximum": 1},
        "affine_aligned_rmse_m": {"type": "number", "minimum": 0},
        "affine_aligned_abs_rel": {"type": "number", "minimum": 0},
        "affine_scale": {"type": "number", "minimum": 0},
        "affine_shift_m": {"type": "number"},
        "alignment_scale_at_boundary": {"type": "boolean"}
      }
    },
    "case_metrics": {"type": "object"},
    "topology": {"type": "object"},
    "support": {"type": "object"},
    "acceptance": {
      "type": "object",
      "properties": {
        "registered_images_min": {"type": "integer"},
        "sparse_points_min": {"type": "integer"},
        "mean_reprojection_error_px_max": {"type": "number"},
        "evaluated_cases_min": {"type": "integer"},
        "valid_pixel_fraction_min": {"type": "number"},
        "raw_rmse_m_max": {"type": "number"},
        "raw_abs_rel_max": {"type": "number"},
        "affine_aligned_rmse_m_max": {"type": "number"}
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "package_version", "container_image", "container_image_id"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "package_version": {"type": "string"},
        "source_commit": {"type": "string"},
        "container_image": {"type": "string"},
        "container_image_id": {"type": "string"}
      }
    },
    "resources": {
      "type": "object",
      "required": ["runtime_seconds", "host"],
      "properties": {
        "runtime_seconds": {"type": "number", "minimum": 0},
        "peak_cpu_memory_bytes": {"type": "integer", "minimum": 1},
        "peak_gpu_compute_memory_bytes": {"type": "integer"},
        "gpu_memory_scope": {"type": "string"},
        "gpu_measurement_status": {"type": "string"},
        "gpu_selection": {"type": "string"},
        "gpu_hardware": {"type": "array"},
        "host": {"type": "string"}
      }
    },
    "provenance": {"type": "object", "required": ["config", "config_sha256", "implementation_sha256", "artifacts_sha256"]}
  },
  "allOf": [
    {
      "if": {"properties": {"adapter": {"enum": ["colmap-sfm", "colmap-mvs"]}}},
      "then": {"properties": {"metrics": {"required": ["registered_images", "sparse_points", "mean_reprojection_error_px"]}}}
    },
    {
      "if": {"properties": {"adapter": {"const": "orb-slam"}}},
      "then": {"properties": {"metrics": {"required": ["input_frames", "tracked_frames", "tracking_coverage", "lost_frames", "tracking_recoveries", "keyframes", "trajectory_matches", "ate_rmse_m", "rpe_translation_rmse_m", "rpe_rotation_rmse_deg", "endpoint_drift_m", "endpoint_rotation_drift_deg", "map_points", "map_truth_points", "map_accuracy_mean_m", "map_completeness_mean_m", "map_precision_10cm", "map_recall_10cm", "map_fscore_10cm"]}}}
    },
    {
      "if": {"properties": {"adapter": {"const": "depth-anything-v2"}}},
      "then": {
        "required": ["case_metrics", "support"],
        "properties": {
          "metrics": {"required": ["evaluated_cases", "evaluated_pixels", "valid_pixels", "valid_pixel_fraction", "raw_rmse_m", "raw_abs_rel", "raw_delta1", "affine_aligned_rmse_m", "affine_aligned_abs_rel", "affine_scale", "affine_shift_m", "alignment_scale_at_boundary"]},
          "tool": {"required": ["source_commit"]}
        }
      }
    },
    {
      "if": {"properties": {"adapter": {"const": "neus-facto"}}},
      "then": {
        "required": ["topology", "support"],
        "properties": {
          "metrics": {
            "required": ["geometry", "rendering", "field", "unsupported"],
            "properties": {
              "geometry": {"type": "object"},
              "rendering": {"type": "object"},
              "field": {"type": "object"},
              "unsupported": {"type": "object"}
            }
          },
          "tool": {"required": ["source_commit", "dependency_commit"]}
        }
      }
    },
    {
      "if": {"properties": {"adapter": {"const": "nerfacto"}}},
      "then": {
        "required": ["support"],
        "properties": {
          "metrics": {
            "required": ["rendering", "geometry", "field", "comparison"],
            "properties": {
              "rendering": {"type": "object"},
              "geometry": {"type": "object"},
              "field": {"type": "object"},
              "comparison": {"type": "object"}
            }
          },
          "tool": {"required": ["source_commit", "dependency_commit"]}
        }
      }
    }
  ]
}
