        "-c",
        "import json,hashlib,math,time,resource,numpy as np,pyarrow.parquet as pq\nfrom pathlib import Path\nfrom pipeline.foreground_support import foreground_support,selection_diagnostics\nstarted=time.monotonic();d=json.loads(Path('/mnt/trusted.json').read_text());o=d['box_source'];p=Path('/tmp/slice')/o['relative_path'];assert hashlib.file_digest(p.open('rb'),'sha256').hexdigest()==o['sha256']\nfields=['center.x','center.y','center.z','size.x','size.y','size.z','heading'];prefix='[LiDARBoxComponent].box.'\nrows=[r for r in pq.read_table(p).to_pylist() if r['key.frame_timestamp_micros']==d['timestamp']]\nassert rows and all(r['key.segment_context_name']==o['context'] for r in rows)\nboxes=np.array([[r[prefix+f] for f in fields] for r in rows]);classes=np.array([r['[LiDARBoxComponent].type'] for r in rows],dtype=np.int64);points=[]\nfor r in d['rows']:\n p=Path('/source/reconstruction')/r['artifact'];assert hashlib.file_digest(p.open('rb'),'sha256').hexdigest()==r['sha256']\n with np.load(p,allow_pickle=False) as a:points.append(a['xyz'])\nxyz=np.concatenate(points);target=foreground_support(xyz,boxes,classes)\n# Independent scalar world-space polygon half-planes plus vertical limits.\nworld=[tuple(map(float,p)) for p in xyz]\nfor box,indices in zip(boxes,target['object_point_indices']):\n cx,cy,cz,l,w,height,heading=map(float,box);cos,sin=math.cos(heading),math.sin(heading)\n corners=[(cx+u*cos-v*sin,cy+u*sin+v*cos) for u,v in [(-l/2,-w/2),(l/2,-w/2),(l/2,w/2),(-l/2,w/2)]]\n reference=[]\n for i,(px,py,pz) in enumerate(world):\n  if abs(pz-cz)>height/2:continue\n  inside=True\n  for j,(ax,ay) in enumerate(corners):\n   bx,by=corners[(j+1)%4]\n   if (bx-ax)*(py-ay)-(by-ay)*(px-ax)<0:inside=False;break\n  if inside:reference.append(i)\n np.testing.assert_array_equal(indices,np.array(reference,dtype=np.int64))\ncontrols={}\nfor name,selected in [('all',np.ones(len(xyz),dtype=bool)),('none',np.zeros(len(xyz),dtype=bool)),('oracle_box_union',target['class_membership'].any(axis=1))]:\n v=selection_diagnostics(target,selected,minimum_points=5);controls[name]=v\n for k,row in v['classes'].items():\n  if row['foreground_points']:assert row['point_recall']==(0 if name=='none' else 1)\nresult={'frame':{'context':o['context'],'timestamp':d['timestamp']},'points':len(xyz),'boxes':len(boxes),'sensor':'TOP','returns':[1,2],'controls':controls,'elapsed_seconds':time.monotonic()-started,'peak_rss_kib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,'scope':'native full pairwise scalar geometry parity and theoretical selection controls; no trained gate or held-out result'}\nPath('/outputs/check.json').write_text(json.dumps(result,indent=2));print('PASS independent native foreground geometry',len(xyz),'points',len(boxes),'boxes')\n"
      ],
