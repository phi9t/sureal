  proof_name=archived_ref(entry['proof']);proof=read(archived(proof_name));archived_ref(entry['native_parent'])
  for artifact in proof['artifacts'].values():archived_ref(artifact)
  for path,digest in entry['output_artifacts'].items():archived_ref({'path':path,'sha256':digest})
  if 'state_comparison' in entry:
   sub=entry['state_comparison'];name=archived_ref(sub['proof']);pv=read(archived(name))
   for artifact in pv['artifacts'].values():archived_ref(artifact)
   for key in ['state_comparison_job','state_comparison_result']:archived_ref(entry[key])
 test_count=0;test_pass=0
 for name in recovered:
  if name.startswith('metadata/live-test-evidence/') and name.endswith('/verified.json'):
   x=read(archived(name));test_count+=1;test_pass+=int(x['passed'] is True);archived_ref(x['log'])
   for path,digest in x.get('source_pins',{}).items():archived_ref({'path':path,'sha256':digest})
   prefix='/'.join(name.split('/')[:-1]);proofname=prefix+'/resources/'+('resource-admitted.json' if x['passed'] else 'attempt.json');assert proofname in recovered
   if x['passed']:
    proof=read(archived(proofname));scope=proof['host_measurement']['kernel_scope'];assert scope['memory_max_bytes']==16*1024**3 and scope['memory_swap_max_bytes']==0 and scope['oom']==scope['oom_kill']==0
    for artifact in proof['artifacts'].values():archived_ref(artifact)
 report['metadata_audit']={'journal_entries':107,'journal_head_sha256':previous,'journal_evidence_references':refs,'test_receipts':test_count,'successful_test_receipts':test_pass,'raw_test_replay_references_checked':len(raw_refs),'native_sources':295,'host_sources':23,'current_extensions':6,'scope':'freshly recovered journal, source snapshots and raw test/replay references; reference state primary byte identities unchanged'};persist()

