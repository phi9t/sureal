def ref(path):return {'path':str(path),'sha256':sha(path)}
def read(path):return json.loads(Path(path).read_text())
def loadref(value):assert regular(Path(value['path'])) and sha(value['path'])==value['sha256'];return read(value['path'])
def equal(a,b,path):
 assert type(a) is type(b),path
 if isinstance(a,dict):
  assert a.keys()==b.keys(),path
  for k in a:equal(a[k],b[k],path+'.'+str(k))
 elif isinstance(a,list):
  assert len(a)==len(b),path
  for i,(u,v) in enumerate(zip(a,b)):equal(u,v,path+'.'+str(i))
 else:
  if isinstance(a,float):assert math.isfinite(a) and math.isfinite(b),path
  assert a==b,path

def guard(reserve=0,label='guard'):
 assert sha(__file__)==report['driver']['sha256']
 b.guard();validate_sources(P/'resources',pins)
 assert {f.relative_to(R/'experiment/resources').as_posix():sha(f) for f in (R/'experiment/resources').rglob('*.py')}=={n:v['sha256'] for n,v in pins.items()}
 for path,digest in originals.items():assert sha(path)==digest
 assert sha(prior_review['resource_identity']['path'])==prior_review['resource_identity']['sha256']
 for path,value in prior_review['owned_sources'].items():assert sha(P/path)==value['sha256']
 science=unique_payload_bytes(W);case=unique_payload_bytes(b.output);scratch=unique_payload_bytes(S)
 assert science+reserve<=15*1024**3,('scientific reserve',science,reserve)
 assert case<=2*1024**3 and scratch<=2*1024**3
 assert unique_payload_bytes(C/'scientific-processing-staging')<=2*1024**3
 report['budget_checks'].append({'label':label,'scientific_bytes':science,'additional_reserve_bytes':reserve,'scientific_cap_bytes':15*1024**3,'original_case_bytes':case,'separate_recovery_scratch_bytes':scratch,'per_case_cap_bytes':2*1024**3});persist()

def get(pub,uri,path,label):
 assert not path.exists()
 for p,d in pub['waystone_tool_sha256'].items():assert sha(p)==d
 command=[str(Path.home()/'workspace/waystone/scripts/waystone'),'--error-format','json','--command-timeout-secs','300','--auth-source','token-file','get',uri,str(path)]
 started=time.monotonic();result=subprocess.run(command,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,timeout=305)
 log=R/'transfers'/(label+'.log');log.write_text(result.stdout)
 report['transfers'].append({'command':command,'exit_code':result.returncode,'seconds':time.monotonic()-started,'log':ref(log)});persist();assert result.returncode==0

def live_archive(pub,chunk,group_index,index,download,mode):
 name=f'g{group_index}-c{index}-{mode}';inputdir=R/'jobs'/name;inputdir.mkdir();out=S/name;out.mkdir();saved=R/'outputs'/name;saved.mkdir()
 library=Path(pub['archive_library']['path']);assert sha(library)==pub['archive_library']['sha256']
 job={'source_sha256':{m['path']:m['sha256'] for m in chunk['manifest']['members']},'max_bytes':128*1024**2,'archive_module_path':'/tmp/resource-archive.py','archive_module_sha256':sha(library),'manifest_sha256':chunk['manifest_sha256']};write_new(inputdir/'job.json',job)
 command=launch_plan(Path(pub['rootfs_path']),R/'experiment',download,out,['python','/experiment/resources/archive_worker.py',mode]);at=command.index('--');command[at:at]=['--ro-bind',str(inputdir),'/tmp/inputs','--ro-bind',str(library),'/tmp/resource-archive.py']
 with (out/'live.log').open('w') as stream:run_stage(command,R/'experiment',dict(os.environ),stream,300,code=R/'code',current_sources=P/'resources',source_pins=pins,evidence_directory=R/'proofs'/name,native_output=out,cap_bytes=16*1024**3)
 proofpath=R/'proofs'/name/'resource-admitted.json';proof=read(proofpath);admission=validate_proof(proof,command,P/'resources',pins,out,16*1024**3,300);result=read(out/'check.json');manifest=chunk['manifest']
 assert result['exact_members_and_hashes'] and result['archive_sha256']==manifest['archive_sha256'] and result['payload_bytes']==manifest['payload_bytes'] and result['members']==len(manifest['members'])
 for f in ['check.json','live.log']:shutil.copyfile(out/f,saved/f)
 report['archive_stages'].append({'group':group_index,'chunk':index,'mode':mode,'proof':ref(proofpath),'job':ref(inputdir/'job.json'),'outputs':{f:ref(saved/f) for f in ['check.json','live.log']},'result':result,'resource_admission':admission,'kernel_scope':proof['host_measurement']['kernel_scope']});persist();return out

def gpu(step):
 guard(label='before-cold-gpu-'+str(step));root=S/'models'/('producer-'+str(step));wanted={n.removeprefix('producer-'+str(step)+'/'):e for n,e in main_expected.items() if n.startswith('producer-'+str(step)+'/')};assert len(wanted)==19
 assert {p.relative_to(root).as_posix():sha(p) for p in root.rglob('*') if p.is_file()}=={n:e['sha256'] for n,e in wanted.items()}
 native_path=b.R/('audit-'+str(step)+'-verified.json');native=read(native_path);b.check_stage(native)
 command=native['command'].copy();out=R/'outputs'/('cold-gpu-'+str(step));out.mkdir();changes={}
 for target,replacement in [('/outputs',out),('/tmp/retained',root),*([('/tmp/previous',S/'prior')] if step else [])]:
  i=command.index(target);assert command[i-2]==('--bind' if target=='/outputs' else '--ro-bind');changes[target]={'original':command[i-1],'fresh':str(replacement)};command[i-1]=str(replacement)
 original=command.copy()
 with (out/'live.log').open('w') as stream:run_stage(command,b.package,dict(os.environ),stream,1800,code=R/'code',current_sources=P/'resources',source_pins=pins,evidence_directory=R/'proofs'/('cold-gpu-'+str(step)),native_output=out,cap_bytes=16*1024**3)
 proofpath=R/'proofs'/('cold-gpu-'+str(step))/'resource-admitted.json';proof=read(proofpath);assert proof['original_command']==original;admission=validate_proof(proof,command,P/'resources',pins,out,16*1024**3,1800)
 comparisons={};measurements={'elapsed_seconds','peak_allocated_bytes','peak_rss_kib'}
 for filename in ['replay.json','transition.json']:
  old=read(Path(native['output_directory'])/filename);fresh=read(out/filename);assert old.keys()==fresh.keys() and measurements<=old.keys()
  for key in measurements:
   for val in [old[key],fresh[key]]:assert type(val) in (int,float) and math.isfinite(val) and val>=0
  assert fresh['peak_allocated_bytes']<=8*1024**3 and fresh['peak_rss_kib']<=16*1024**2
  equal({k:v for k,v in old.items() if k not in measurements},{k:v for k,v in fresh.items() if k not in measurements},filename)
  comparisons[filename]={'original':ref(Path(native['output_directory'])/filename),'fresh':ref(out/filename),'fresh_measured':{k:fresh[k] for k in measurements}}
 report['gpu_stages'].append({'step':step,'native_parent':ref(native_path),'proof':ref(proofpath),'readonly_recovered_mount_changes':changes,'cold_members':{n:e['sha256'] for n,e in wanted.items()},'comparisons':comparisons,'all_nonmeasurement_values_exact':True,'resource_admission':admission,'kernel_scope':proof['host_measurement']['kernel_scope'],'scope':'actual unchanged native transition/all16-head GPU worker consuming freshly HDFS-recovered model members with unchanged local admitted inputs/runtime/GT'});persist()
 release={str(p):sha(p) for p in root.rglob('*') if p.is_file()}
 if step==0:
  (S/'prior').mkdir();os.replace(root/'checkpoint.pt',S/'prior/checkpoint.pt');release.pop(str(root/'checkpoint.pt'));assert sha(S/'prior/checkpoint.pt')==wanted['checkpoint.pt']['sha256']
 write_new(R/('cold-gpu-'+str(step)+'-temporary-release.json'),{'scope':'only fresh verified HDFS recovery temporaries after successful cold GPU audit; originals and replay sources retained','members':release});shutil.rmtree(root)
 if step==1000:
  write_new(R/'cold-prior-temporary-release.json',ref(S/'prior/checkpoint.pt'));shutil.rmtree(S/'prior')
 guard(label='after-cold-gpu-'+str(step))

def archived(name):return S/'retained-metadata'/name

