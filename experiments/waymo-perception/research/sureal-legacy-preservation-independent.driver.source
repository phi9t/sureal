   original=Path(record['root'])
   if path.is_relative_to(original):return 'producer-'+str(record['step'])+'/'+path.relative_to(original).as_posix()
  for entry in replay['stages']:
   if entry['requested_stage'].startswith('train-'):
    native=Path(read(entry['proof']['path'])['native_output_directory'])
    if path.is_relative_to(native):return 'replay-'+entry['requested_stage'].split('-')[-1]+'/'+path.relative_to(native).as_posix()
  if path.is_relative_to('/tmp'):
   relative=path.relative_to('/tmp');prefix='metadata/independent-live/' if relative.parts[0].startswith('sureal-legacy-independent-state-') else 'metadata/live-test-evidence/';return prefix+relative.as_posix()
  raise ValueError('unmapped raw reference '+str(path))
