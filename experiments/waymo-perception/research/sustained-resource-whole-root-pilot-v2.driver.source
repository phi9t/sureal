rootfs=Path(pub['rootfs_path']);masked={'experiment','source','outputs','dev','proc','tmp'};all_entries=sorted(rootfs.iterdir(),key=lambda p:p.name);entries=[p for p in all_entries if p.name not in masked]
command=launch_plan(rootfs,Path(pub['execution_directory']),raw,out,['python','/experiment/resources/retention_audit.py'])
