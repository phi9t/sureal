record={'scope':'retained v3 byte-identical resource whole-union launcher pilot; no new transfer/training/release','driver_sha256':sha(__file__),'rootfs_sha256':pub['runtime_lock']['rootfs_sha256'],'rootfs_top_level_readonly_bindings':bindings,'source_pins':pins,'input_sha256':{str(p):sha(p) for p in (old/'audit-input').iterdir()}}
record['masked_runtime_role_entries']=[p.name for p in all_entries if p.name in masked];record['runtime_source_entry_types']={p.name:{'kind':'symlink' if p.is_symlink() else 'directory' if p.is_dir() else 'file','symlink_target':os.readlink(p) if p.is_symlink() else None} for p in all_entries}
