 with (out/'live.log').open('w') as stream:run_stage(command,Path(pub['execution_directory']),dict(os.environ),stream,300,code=code,current_sources=P/'resources',source_pins=pins,evidence_directory=R/'proofs/whole',native_output=out,cap_bytes=16*1024**3)
 proof=R/'proofs/whole/resource-admitted.json';value=json.loads(proof.read_text());validate_proof(value,command,P/'resources',pins,out,16*1024**3,300)
 record.update({'passed':True,'command':command,'resource_proof_path':str(proof),'resource_proof_sha256':sha(proof),'validation':json.loads((out/'check.json').read_text())})
except BaseException as error:
 record.update({'passed':False,'error':str(error),'command':command});write_new(R/'failure.json',record);raise
