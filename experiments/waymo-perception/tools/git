#!/usr/bin/env python3
"""Small Git command double for Bazel tests running in the minimal rootfs."""
import base64
import json
import sys
from pathlib import Path


STATE = "sureal-git-shim-snapshot.json"


def clean_args(argv):
    result = []
    index = 0
    while index < len(argv):
        if argv[index] == "-c":
            index += 2
            continue
        result.append(argv[index])
        index += 1
    return result


def state_path(root):
    return root / ".git" / STATE


def snapshot(root):
    path = state_path(root)
    if not path.is_file():
        return None
    return {
        name: base64.b64decode(value.encode("ascii"))
        for name, value in json.loads(path.read_text()).items()
    }


def iter_files(root):
    for path in root.rglob("*"):
        if not path.is_file() or ".git" in path.parts or "__pycache__" in path.parts:
            continue
        yield path.relative_to(root).as_posix(), path.read_bytes()


def current_files(root):
    return dict(iter_files(root))


def normalize_patterns(root, patterns):
    normalized = []
    for pattern in patterns:
        path = Path(pattern)
        if path.is_absolute():
            try:
                relative = path.resolve().relative_to(root.resolve()).as_posix()
            except ValueError:
                continue
            normalized.append(relative or ".")
        else:
            normalized.append(pattern)
    return normalized


def selected(names, patterns):
    if not patterns:
        return names
    result = []
    for name in names:
        for pattern in patterns:
            if pattern == ".":
                result.append(name)
                break
            if pattern in ("*.py", "**/*.py") and name.endswith(".py"):
                result.append(name)
                break
            if pattern.endswith("*.py") and name.startswith(pattern[:-4]) and name.endswith(".py"):
                result.append(name)
                break
            if name == pattern or name.startswith(pattern.rstrip("/") + "/"):
                result.append(name)
                break
    return result


def command_ls_files(root, args):
    separator = "\0" if "-z" in args else "\n"
    patterns = normalize_patterns(root, args[args.index("--") + 1:] if "--" in args else [])
    files = snapshot(root) or current_files(root)
    names = selected(sorted(files), patterns)
    sys.stdout.write(separator.join(names) + (separator if names else ""))


def command_commit(root):
    (root / ".git").mkdir(exist_ok=True)
    encoded = {
        name: base64.b64encode(data).decode("ascii")
        for name, data in current_files(root).items()
    }
    state_path(root).write_text(json.dumps(encoded, sort_keys=True))


def command_diff(root):
    base = snapshot(root) or {}
    now = current_files(root)
    fields = []
    for name, data in sorted(base.items()):
        if name not in now:
            fields.extend(["D", name])
        elif now[name] != data:
            fields.extend(["M", name])
    sys.stdout.write("\0".join(fields) + ("\0" if fields else ""))


def command_show(root, spec):
    try:
        _, name = spec.split(":./", 1)
    except ValueError:
        raise SystemExit(f"unsupported git show spec: {spec}")
    data = (snapshot(root) or {}).get(name)
    if data is None:
        raise SystemExit(f"path not found in git shim snapshot: {name}")
    sys.stdout.buffer.write(data)


def main(argv=None):
    args = clean_args(list(sys.argv[1:] if argv is None else argv))
    if not args:
        return 2
    command, rest = args[0], args[1:]
    root = Path.cwd()
    if command == "init":
        (root / ".git").mkdir(exist_ok=True)
        return 0
    if command == "add":
        return 0
    if command == "commit":
        command_commit(root)
        return 0
    if command == "mv" and len(rest) == 2:
        source, destination = (root / rest[0], root / rest[1])
        destination.parent.mkdir(parents=True, exist_ok=True)
        source.rename(destination)
        return 0
    if command == "ls-files":
        command_ls_files(root, rest)
        return 0
    if command == "diff":
        command_diff(root)
        return 0
    if command == "show" and rest:
        command_show(root, rest[-1])
        return 0
    print(f"unsupported git shim command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
