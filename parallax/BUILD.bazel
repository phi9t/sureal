load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "camera_lib",
    srcs = glob(["camera/*.py"]),
    imports = ["."],
)

py_library(
    name = "geometry_lib",
    srcs = glob(["geometry/*.py"], exclude = ["geometry/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "features_lib",
    srcs = glob(["features/*.py"], exclude = ["features/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "fusion_lib",
    srcs = glob(["fusion/*.py"], exclude = ["fusion/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "evaluation_lib",
    srcs = glob(
        ["evaluation/*.py"],
        exclude = ["evaluation/*_test.py"],
    ),
    imports = ["."],
)

py_library(
    name = "scene_lib",
    srcs = glob(["scene/*.py"], exclude = ["scene/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "stereo_lib",
    srcs = glob(["stereo/*.py"], exclude = ["stereo/*_test.py"]),
    imports = ["."],
    deps = [
        ":camera_lib",
        ":evaluation_lib",
        ":pipeline_lib",
        ":scene_lib",
    ],
)

py_library(
    name = "sfm_lib",
    srcs = glob(["sfm/*.py"], exclude = ["sfm/*_test.py"]),
    imports = ["."],
    deps = [
        ":camera_lib",
        ":evaluation_lib",
        ":features_lib",
        ":geometry_lib",
        ":scene_lib",
    ],
)

py_library(
    name = "baselines_lib",
    srcs = glob(["baselines/*.py"], exclude = ["baselines/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "curriculum_lib",
    srcs = glob(["curriculum/*.py"], exclude = ["curriculum/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "pipeline_lib",
    srcs = glob(["pipeline/*.py"], exclude = ["pipeline/*_test.py"]),
    imports = ["."],
)

py_library(
    name = "parallax_lib",
    srcs = glob(
        [
            "baselines/*.py",
            "camera/*.py",
            "curriculum/*.py",
            "evaluation/*.py",
            "features/*.py",
            "fusion/*.py",
            "geometry/*.py",
            "pipeline/*.py",
            "scene/*.py",
            "sfm/*.py",
            "stereo/*.py",
        ],
        exclude = ["**/*_test.py"],
    ),
    imports = ["."],
)

filegroup(
    name = "runtime_data",
    srcs = glob([
        "assets/*.json",
        "baselines/*.py",
        "camera/*.py",
        "curriculum/*.json",
        "curriculum/*.py",
        "evaluation/*.py",
        "features/*.py",
        "fusion/*.py",
        "geometry/*.py",
        "insulas/**",
        "pipeline/*.py",
        "scene/*.json",
        "scene/*.py",
        "sfm/*.py",
        "stereo/*.py",
        "schemas/*.json",
    ]) + [
        "README.md",
        "run.sh",
    ],
)

py_binary(
    name = "parallax_cli",
    srcs = ["pipeline/cli.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "pipeline/cli.py",
    deps = [
        ":parallax_lib",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "mvs_live_check",
    srcs = ["stereo/live_check.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "stereo/live_check.py",
    deps = [
        ":parallax_lib",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "fusion_live_check",
    srcs = ["fusion/live_check.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "fusion/live_check.py",
    deps = [
        ":parallax_lib",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "generate_orbit_scene",
    srcs = ["scene/orbit.py"],
    imports = ["."],
    legacy_create_init = 0,
    main = "scene/orbit.py",
    deps = [
        ":parallax_lib",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "two_view_orbit",
    srcs = ["pipeline/two_view_orbit.py"],
    data = [":runtime_data"],
    imports = ["."],
    legacy_create_init = 0,
    main = "pipeline/two_view_orbit.py",
    deps = [":parallax_lib"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "run",
    srcs = ["pipeline/cli.py"],
    data = [":runtime_data"],
    imports = ["."],
    legacy_create_init = 0,
    main = "pipeline/cli.py",
    deps = [":parallax_lib"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_support",
    srcs = ["baselines/colmap_reference_test.py"],
)

_PARALLAX_TESTS = {
    "test_feature_matching": "features/feature_matching_test.py",
    "test_fusion": "fusion/fusion_test.py",
    "test_classical": "geometry/classical_test.py",
    "test_two_view_orbit": "pipeline/two_view_orbit_test.py",
    "test_two_view_geometry": "geometry/two_view_test.py",
    "test_colmap_mvs_reference": "baselines/colmap_mvs_reference_test.py",
    "test_colmap_reference": "baselines/colmap_reference_test.py",
    "test_classical_chain": "pipeline/classical_chain_test.py",
    "test_classical_chain_full": "pipeline/classical_chain_full_test.py",
    "test_controlled_suite": "scene/controlled_suite_test.py",
    "test_depth_anything_reference": "baselines/depth_anything_reference_test.py",
    "test_documentation": "curriculum/documentation_test.py",
    "test_e2e_completion": "pipeline/e2e_completion_test.py",
    "test_orbit_scene": "scene/orbit_test.py",
    "test_plane_sweep": "stereo/plane_sweep_test.py",
    "test_depth_filter": "stereo/depth_filter_test.py",
    "test_stereo_cost": "stereo/cost_test.py",
    "test_pose_metrics": "evaluation/pose_metrics_test.py",
    "test_sfm_bundle_adjust": "sfm/bundle_adjust_test.py",
    "test_incremental_sfm": "sfm/incremental_test.py",
    "test_sfm_tracks": "sfm/tracks_test.py",
    "test_surface_metrics": "evaluation/surface_metrics_test.py",
    "test_fetch": "pipeline/fetch_test.py",
    "test_foundation": "pipeline/foundation_test.py",
    "test_foundation_geometry_reference": "baselines/foundation_geometry_reference_test.py",
    "test_generation_dynamic_surflo": "curriculum/generation_dynamic_surflo_test.py",
    "test_nerfacto_reference": "baselines/nerfacto_reference_test.py",
    "test_neural_rendering": "curriculum/neural_rendering_test.py",
    "test_neus_facto_reference": "baselines/neus_facto_reference_test.py",
    "test_orb_slam_reference": "baselines/orb_slam_reference_test.py",
    "test_review_fixes": "pipeline/review_fixes_test.py",
    "test_splatfacto_reference": "baselines/splatfacto_reference_test.py",
}

[
    py_test(
        name = name,
        srcs = [source],
        data = [
            ":runtime_data",
            ":test_support",
        ],
        imports = ["."],
        legacy_create_init = 0,
        main = source,
        size = "large" if name in ["test_incremental_sfm", "test_classical_chain_full"] else "medium",
        deps = [":parallax_lib"],
    )
    for name, source in _PARALLAX_TESTS.items()
]
