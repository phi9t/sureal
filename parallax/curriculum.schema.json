{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anttwo.github.io/surflo/schemas/3d-pathway-curriculum-v1.json",
  "title": "Surflo 3D reconstruction pathway curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cutoff", "coordinate_convention", "profiles", "insulas", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "cutoff": {"type": "string", "format": "date"},
    "coordinate_convention": {"type": "string", "minLength": 1},
    "profiles": {"type": "object", "required": ["smoke", "full"]},
    "insulas": {"type": "object", "required": ["classical", "neural-rendering", "blender", "surflo"]},
    "modules": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "$defs": {
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "evidence", "observable", "representation", "inference", "objectives", "metrics", "failure_sweep", "insula", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{2}$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/nonemptyStrings"},
        "observable": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "inference": {"enum": ["analytic", "optimized", "amortized", "sampled", "hybrid"]},
        "objectives": {"$ref": "#/$defs/nonemptyStrings"},
        "metrics": {"$ref": "#/$defs/nonemptyStrings"},
        "failure_sweep": {"$ref": "#/$defs/nonemptyStrings"},
        "insula": {"enum": ["classical", "neural-rendering", "blender", "surflo"]},
        "sources": {"$ref": "#/$defs/nonemptyStrings"}
      }
    }
  }
}
